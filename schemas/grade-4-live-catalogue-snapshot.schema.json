{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/schemas/grade-4-live-catalogue-snapshot.schema.json",
  "title": "Dated public Grade 4 Opiq catalogue snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "snapshot_id",
    "verified_on",
    "completeness_status",
    "catalogue_interface",
    "evidence_sources",
    "records",
    "limitations"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/version" },
    "artifact_type": { "const": "grade-4-live-catalogue-snapshot" },
    "snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
    "verified_on": { "$ref": "#/$defs/date" },
    "completeness_status": { "$ref": "#/$defs/completenessStatus" },
    "catalogue_interface": { "$ref": "#/$defs/catalogueInterface" },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceSource" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/liveRecord" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"], "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "httpUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "completenessStatus": {
      "enum": [
        "complete_for_declared_filter",
        "partial_public_discovery",
        "partial_manual_snapshot",
        "blocked_authentication_or_pagination",
        "unknown_completeness"
      ]
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_phrase",
        "curriculum_or_programme",
        "material_type",
        "grade",
        "subject",
        "publisher",
        "package_or_access",
        "language",
        "sort_order"
      ],
      "properties": {
        "search_phrase": { "type": "string" },
        "curriculum_or_programme": { "$ref": "#/$defs/nonEmptyString" },
        "material_type": { "$ref": "#/$defs/nonEmptyString" },
        "grade": { "$ref": "#/$defs/nonEmptyString" },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "publisher": { "$ref": "#/$defs/nonEmptyString" },
        "package_or_access": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "sort_order": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "stableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "identity_input"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "identity_input": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "catalogueInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "capture_method",
        "selected_filters",
        "pagination",
        "displayed_result_count",
        "material_type_breakdown",
        "stable_source_identity"
      ],
      "properties": {
        "url": { "$ref": "#/$defs/httpUrl" },
        "capture_method": { "$ref": "#/$defs/nonEmptyString" },
        "selected_filters": { "$ref": "#/$defs/filters" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages_observed", "all_result_pages_captured", "pagination_controls_present"],
          "properties": {
            "pages_observed": { "type": "integer", "minimum": 1 },
            "all_result_pages_captured": { "type": "boolean" },
            "pagination_controls_present": { "type": "boolean" }
          }
        },
        "displayed_result_count": { "type": "integer", "minimum": 0 },
        "material_type_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["learning_kits", "teacher_books"],
          "properties": {
            "learning_kits": { "type": "integer", "minimum": 0 },
            "teacher_books": { "type": "integer", "minimum": 0 }
          }
        },
        "stable_source_identity": { "$ref": "#/$defs/stableIdentity" }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ref", "evidence_type", "url", "verified_on", "note"],
      "properties": {
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_type": {
          "enum": [
            "direct_live_evidence",
            "catalogue_filter_evidence",
            "manual_review_evidence",
            "search_discovery_only",
            "repository_capture_evidence",
            "derived_comparison"
          ]
        },
        "url": {
          "oneOf": [
            { "$ref": "#/$defs/httpUrl" },
            { "type": "null" }
          ]
        },
        "verified_on": { "$ref": "#/$defs/date" },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "primaryClassification": {
      "enum": [
        "canonical_student_source",
        "captured_student_source_not_canonical",
        "missing_student_source_candidate",
        "teacher_support",
        "teacher_only",
        "multi_grade_support",
        "supplementary_shared",
        "simplified_curriculum",
        "mixed_subject",
        "edition_or_replacement",
        "obsolete_or_superseded_candidate",
        "detail_only_or_no_instructional_capture",
        "unknown"
      ]
    },
    "liveRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kit_id",
        "kit_details_url",
        "verified_on",
        "capture_method",
        "evidence_status",
        "title",
        "material_type",
        "subject",
        "grade_scope",
        "languages",
        "publisher",
        "authors",
        "edition_or_year",
        "programme_or_support_role",
        "curriculum_labels",
        "package_or_access",
        "chapter_count",
        "task_count",
        "textbook_task_count",
        "task_collection_task_count",
        "catalogue_filters",
        "source_evidence_refs",
        "evidence_limitations",
        "primary_classification",
        "secondary_roles"
      ],
      "properties": {
        "kit_id": { "type": "string", "pattern": "^[0-9]+$" },
        "kit_details_url": { "type": "string", "pattern": "^https://www[.]opiq[.]ee/Kit/Details/[0-9]+$" },
        "verified_on": { "$ref": "#/$defs/date" },
        "capture_method": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_status": {
          "enum": [
            "direct_live_evidence",
            "catalogue_filter_evidence",
            "manual_review_evidence",
            "search_discovery_only",
            "repository_capture_evidence",
            "derived_comparison"
          ]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "material_type": { "$ref": "#/$defs/nonEmptyString" },
        "subject": { "$ref": "#/$defs/nullableString" },
        "grade_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "publisher": { "$ref": "#/$defs/nullableString" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "edition_or_year": { "$ref": "#/$defs/nullableString" },
        "programme_or_support_role": { "$ref": "#/$defs/nonEmptyString" },
        "curriculum_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "package_or_access": { "$ref": "#/$defs/nullableString" },
        "chapter_count": { "type": ["integer", "null"], "minimum": 0 },
        "task_count": { "type": ["integer", "null"], "minimum": 0 },
        "textbook_task_count": { "type": ["integer", "null"], "minimum": 0 },
        "task_collection_task_count": { "type": ["integer", "null"], "minimum": 0 },
        "catalogue_filters": { "$ref": "#/$defs/filters" },
        "source_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidence_limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "primary_classification": { "$ref": "#/$defs/primaryClassification" },
        "secondary_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/primaryClassification" }
        }
      }
    }
  }
}
