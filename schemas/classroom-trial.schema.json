{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/classroom-trial.schema.json",
  "title": "Opiq Helper privacy-safe classroom pedagogical trial record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "trial_id",
    "pack_ref",
    "evidence_identity",
    "lifecycle",
    "trial_status",
    "context",
    "privacy",
    "conducted_at",
    "timing_observations",
    "instruction_comprehension",
    "retrieval_and_correction",
    "recall_and_transfer",
    "participation_and_completion",
    "language_support",
    "differentiation_adjustments",
    "lesson_dna_deviations",
    "lesson_dna_deviation_status",
    "material_usability",
    "safety_observations",
    "method_execution_observations",
    "unexpected_support",
    "findings",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "artifact_type": {
      "const": "classroom_trial"
    },
    "trial_id": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/idOrTemplateId"
    },
    "pack_ref": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
    },
    "evidence_identity": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/evidenceIdentityOrNull"
    },
    "lifecycle": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/evidenceLifecycle"
    },
    "trial_status": {
      "enum": [
        "draft",
        "conducted",
        "analysed",
        "superseded"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_ids",
        "setting",
        "grade",
        "approximate_group_size",
        "learner_estonian_profile",
        "instruction_language",
        "subject_support_language",
        "teacher_role"
      ],
      "properties": {
        "lesson_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
          }
        },
        "setting": {
          "enum": [
            "classroom",
            "small_group"
          ]
        },
        "grade": {
          "type": "integer",
          "minimum": 1
        },
        "approximate_group_size": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "learner_estonian_profile": {
          "type": "string",
          "minLength": 1
        },
        "instruction_language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        },
        "subject_support_language": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 8
            }
          ]
        },
        "teacher_role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "privacy": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/privacy"
    },
    "conducted_at": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/nullableDate"
    },
    "timing_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timingObservation"
      }
    },
    "instruction_comprehension": {
      "$ref": "#/$defs/observationArray"
    },
    "retrieval_and_correction": {
      "$ref": "#/$defs/observationArray"
    },
    "recall_and_transfer": {
      "$ref": "#/$defs/observationArray"
    },
    "participation_and_completion": {
      "$ref": "#/$defs/observationArray"
    },
    "language_support": {
      "$ref": "#/$defs/observationArray"
    },
    "differentiation_adjustments": {
      "$ref": "#/$defs/observationArray"
    },
    "lesson_dna_deviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviation"
      }
    },
    "lesson_dna_deviation_status": {
      "enum": [
        "not_observed",
        "none_observed",
        "observed"
      ]
    },
    "material_usability": {
      "$ref": "#/$defs/observationArray"
    },
    "safety_observations": {
      "$ref": "#/$defs/observationArray"
    },
    "method_execution_observations": {
      "$ref": "#/$defs/observationArray"
    },
    "unexpected_support": {
      "$ref": "#/$defs/observationArray"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/finding"
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trial_status": {
            "const": "analysed"
          }
        },
        "required": [
          "trial_status"
        ]
      },
      "then": {
        "properties": {
          "timing_observations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_dna_deviation_status": {
            "const": "observed"
          }
        },
        "required": [
          "lesson_dna_deviation_status"
        ]
      },
      "then": {
        "properties": {
          "lesson_dna_deviations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trial_status": {
            "enum": [
              "analysed",
              "superseded"
            ]
          }
        },
        "required": [
          "trial_status"
        ]
      },
      "then": {
        "properties": {
          "trial_id": {
            "type": "string",
            "pattern": "^(?!.*YYYY-MM-DD)[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "evidence_identity": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/evidenceIdentity"
          },
          "conducted_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "context": {
            "type": "object",
            "properties": {
              "lesson_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "privacy": {
            "type": "object",
            "properties": {
              "free_text_checked_for_identifiers": {
                "const": true
              }
            }
          },
          "decision": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "changes_required",
                  "repeat_trial_required",
                  "successful_with_notes",
                  "successful"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trial_status": {
            "const": "superseded"
          }
        },
        "required": [
          "trial_status"
        ]
      },
      "then": {
        "properties": {
          "timing_observations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "observationArray": {
      "type": "array",
      "items": {
        "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/categoricalObservation"
      }
    },
    "timingObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "phase_id",
        "planned_minutes",
        "actual_minutes",
        "setup_feasible",
        "transition_feasible",
        "summary"
      ],
      "properties": {
        "lesson_id": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
        },
        "phase_id": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
        },
        "planned_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "actual_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "setup_feasible": {
          "type": "boolean"
        },
        "transition_feasible": {
          "type": "boolean"
        },
        "finding_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "phase_ids",
        "target_ids",
        "description",
        "reason"
      ],
      "properties": {
        "lesson_id": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
        },
        "phase_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
          }
        },
        "target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "finding_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "safe_to_repeat",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "changes_required",
            "repeat_trial_required",
            "successful_with_notes",
            "successful"
          ]
        },
        "safe_to_repeat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
