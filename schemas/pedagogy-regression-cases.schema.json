{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/pedagogy-regression-cases.schema.json",
  "title": "Pedagogical regression case catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "regression_catalogue_version",
    "engine_version",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "pedagogy_regression_case_catalogue" },
    "regression_catalogue_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "engine_version": { "const": "1.0" },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": { "$ref": "#/$defs/regressionCase" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "caseKind": {
      "enum": [
        "architecture_only",
        "deliberate_failure",
        "production_classroom",
        "production_homeschool",
        "stale_evidence"
      ]
    },
    "caseStatus": {
      "enum": [
        "architecture_only",
        "expected_failure",
        "production_baseline",
        "stale_evidence"
      ]
    },
    "deliveryMode": {
      "enum": [
        "classroom",
        "homeschool",
        "independent_study",
        "parent_supported",
        "remote"
      ]
    },
    "invariantId": {
      "enum": [
        "adapted_contract_complete",
        "additional_scaffolding_present",
        "adult_supervision_preserved",
        "answer_key_after_attempt",
        "answer_leak_absent",
        "architecture_only_not_ready",
        "assessment_separated",
        "collaborative_method_present",
        "comparison_capability_present",
        "delayed_retrieval_future",
        "diagnostic_detected",
        "grade_delivery_compatible",
        "group_context_compatible",
        "language_demand_within_ceiling",
        "map_data_capability_present",
        "material_alignment",
        "no_effectiveness_claim",
        "no_production_artifacts_claimed",
        "parent_role_bounded",
        "quiet_individual_method_present",
        "readiness_evidence_gated",
        "retrieval_correction_after_attempt",
        "retrieval_source_closed",
        "selection_failure_detected",
        "selection_success",
        "self_explanation_present",
        "source_identity_current",
        "structural_claim_blocked",
        "structurally_complete",
        "teacher_override_rationale_preserved",
        "timing_reconciled"
      ]
    },
    "nonGuarantee": {
      "enum": [
        "not_curriculum_complete",
        "not_effectiveness_evidence",
        "not_production_material",
        "not_teacher_approved",
        "not_trial_evidence"
      ]
    },
    "sourceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "record_id",
        "selection_fixture_id",
        "transform_id",
        "scenario_id",
        "artifact_paths"
      ],
      "properties": {
        "scope_kind": {
          "enum": [
            "architecture_selection",
            "policy_mutation",
            "production_record",
            "quality_mutation",
            "selection_mutation"
          ]
        },
        "record_id": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "selection_fixture_id": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "transform_id": {
          "enum": [
            "age_inappropriate",
            "ecosystem_comparison",
            "none",
            "self_explanation"
          ]
        },
        "scenario_id": {
          "enum": [
            "architecture_only_production_ready",
            "classroom_method_in_homeschool",
            "combined_assessment",
            "immediate_instead_delayed",
            "language_demand_above_ceiling",
            "learner_answer_leak",
            "missing_adapted_task_contract",
            "missing_adult_supervision",
            "none",
            "open_source_retrieval",
            "parent_subject_teaching",
            "stale_catalogue_digest",
            "stale_classroom_trial",
            "stale_content_identity",
            "stale_selection_rules",
            "stale_teacher_pack_fingerprint",
            "stale_teacher_review",
            "stale_taxonomy_version",
            "timing_overflow",
            "wrong_task_binding"
          ]
        },
        "artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "expectedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "include_target_ids", "exclude_target_ids"],
      "properties": {
        "status": { "enum": ["failure", "not_applicable", "success"] },
        "include_target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[a-z0-9._:-]*[a-z0-9])?$"
          }
        },
        "exclude_target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[a-z0-9._:-]*[a-z0-9])?$"
          }
        }
      }
    },
    "expectedDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "gate_id"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "gate_id": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        }
      }
    },
    "expectedClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pedagogy_schema_valid",
        "structurally_complete",
        "production_ready",
        "effectiveness_claimed",
        "curriculum_complete"
      ],
      "properties": {
        "pedagogy_schema_valid": {
          "type": ["boolean", "null"]
        },
        "structurally_complete": {
          "type": ["boolean", "null"]
        },
        "production_ready": { "const": false },
        "effectiveness_claimed": { "const": false },
        "curriculum_complete": { "const": false }
      }
    },
    "regressionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regression_id",
        "schema_version",
        "status",
        "case_kind",
        "title_ru",
        "grade",
        "subject",
        "delivery_mode",
        "handler_id",
        "source_scope",
        "expected_selection",
        "expected_invariants",
        "expected_diagnostics",
        "expected_claims",
        "non_guarantees"
      ],
      "properties": {
        "regression_id": { "$ref": "#/$defs/stableId" },
        "schema_version": { "const": "1.0" },
        "status": { "$ref": "#/$defs/caseStatus" },
        "case_kind": { "$ref": "#/$defs/caseKind" },
        "title_ru": { "type": "string", "minLength": 20 },
        "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
        "subject": {
          "enum": [
            "arts_and_crafts",
            "cross_curricular",
            "human_studies",
            "languages",
            "mathematics",
            "music",
            "science"
          ]
        },
        "delivery_mode": { "$ref": "#/$defs/deliveryMode" },
        "handler_id": { "$ref": "#/$defs/stableId" },
        "source_scope": { "$ref": "#/$defs/sourceScope" },
        "expected_selection": { "$ref": "#/$defs/expectedSelection" },
        "expected_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/invariantId" }
        },
        "expected_diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedDiagnostic" }
        },
        "expected_claims": { "$ref": "#/$defs/expectedClaims" },
        "non_guarantees": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonGuarantee" }
        }
      }
    }
  }
}
