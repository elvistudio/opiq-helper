{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/teacher-pack.schema.json",
  "title": "Opiq Helper teacher-pack material index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "pack_id",
    "unit_ref",
    "pack_path",
    "grade",
    "subject",
    "subject_et",
    "instruction_language",
    "subject_support_language",
    "canonical_route",
    "lesson_ids",
    "opiq_sources",
    "reviewable_content",
    "pedagogical_review",
    "classroom_trial",
    "home_trial",
    "readiness",
    "materials"
  ],
  "properties": {
    "schema_version": { "enum": ["1.2", "1.3"] },
    "artifact_type": { "const": "teacher_pack_materials_index" },
    "pack_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" },
    "unit_ref": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" },
    "pack_path": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath" },
    "grade": { "type": "integer", "minimum": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "subject_et": { "type": "string", "minLength": 1 },
    "instruction_language": { "const": "ru" },
    "subject_support_language": { "const": "et" },
    "canonical_route": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/canonicalRoute" },
    "lesson_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" }
    },
    "opiq_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "canonical_url", "lesson_ids"],
        "properties": {
          "record_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" },
          "canonical_url": { "type": "string", "pattern": "^https://www\\.opiq\\.ee/kit/[0-9]+/chapter/[0-9]+$" },
          "lesson_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" }
          }
        }
      }
    },
    "reviewable_content": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/reviewableContent"
    },
    "pedagogical_review": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/pedagogicalEvidenceReviewLink"
    },
    "classroom_trial": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/classroomTrialLink"
    },
    "home_trial": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/homeTrialLink"
    },
    "readiness": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/pedagogicalReadinessLink"
    },
    "pedagogical_integration": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogy-generation-integration.schema.json#/$defs/teacherPackIntegration"
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lesson_ids", "required_for_pack", "material"],
        "properties": {
          "lesson_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" }
          },
          "required_for_pack": { "type": "boolean" },
          "material": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/authorMaterial" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.3" } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "pedagogical_integration": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogy-generation-integration.schema.json#/$defs/teacherPackIntegration"
          }
        },
        "required": ["pedagogical_integration"]
      },
      "else": { "properties": { "pedagogical_integration": false } }
    }
  ]
}
