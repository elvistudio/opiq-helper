{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/pedagogy-quality-gates.schema.json",
  "title": "Pedagogical quality gate catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "catalogue_version",
    "claim_origin",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "pedagogical_quality_gate_catalogue" },
    "catalogue_version": { "const": "1.1" },
    "claim_origin": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/claimOrigin"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_version",
        "title",
        "description",
        "applies_to",
        "severity",
        "guarantee",
        "non_guarantees",
        "exception_policy",
        "claim_origin"
      ],
      "properties": {
        "gate_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "gate_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 8 },
        "description": { "type": "string", "minLength": 20 },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "homeschool_package",
              "integrated_lesson",
              "legacy_lesson",
              "teacher_pack",
              "thematic_plan"
            ]
          }
        },
        "severity": { "enum": ["error", "warning", "info"] },
        "guarantee": { "type": "string", "minLength": 20 },
        "non_guarantees": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 15 }
        },
        "exception_policy": {
          "enum": ["exact_record_only", "prohibited"]
        },
        "claim_origin": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/claimOrigin"
        }
      }
    }
  }
}
