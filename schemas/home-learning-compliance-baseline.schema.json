{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/schemas/home-learning-compliance-baseline.schema.json",
  "title": "Parent-requested home-learning compliance baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "baseline_id",
    "target_school_year",
    "source_registry_ref",
    "requirements",
    "family_evidence_practices",
    "completeness"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "home_learning_compliance_baseline" },
    "baseline_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "target_school_year": { "const": "2026/27" },
    "source_registry_ref": { "$ref": "#/$defs/repositoryPath" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "family_evidence_practices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/practice" }
    },
    "completeness": { "$ref": "#/$defs/completeness" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "title_ru",
        "official_wording_et",
        "plain_language_ru",
        "source_id",
        "official_reference",
        "effective_from",
        "effective_to",
        "target_school_year_applicability",
        "scope",
        "obligation_holder",
        "requirement_level",
        "evidence_status",
        "implementation_evidence",
        "failure_consequence",
        "school_agreement_needed",
        "notes"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^ee-(?:pgs-2026-home-learning|home-reg-2025-[a-z0-9]+|school-records-2025)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title_ru": { "type": "string", "minLength": 1 },
        "official_wording_et": { "type": "string", "minLength": 1 },
        "plain_language_ru": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "official_reference": { "type": "string", "minLength": 1 },
        "effective_from": { "$ref": "#/$defs/date" },
        "effective_to": {
          "oneOf": [
            { "$ref": "#/$defs/date" },
            { "type": "null" }
          ]
        },
        "target_school_year_applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["school_year", "status"],
          "properties": {
            "school_year": { "const": "2026/27" },
            "status": { "enum": ["applicable", "not_applicable", "partial", "ambiguous"] }
          }
        },
        "scope": {
          "enum": [
            "eligibility_and_decision",
            "responsibility_and_financing",
            "individual_curriculum",
            "oversight_and_assessment",
            "school_records",
            "interruption"
          ]
        },
        "obligation_holder": { "enum": ["parent", "student", "school", "director", "teacher", "joint"] },
        "requirement_level": {
          "enum": ["mandatory", "conditional", "discretionary", "school_specific", "recommendation"]
        },
        "evidence_status": { "enum": ["verified", "partial", "missing", "ambiguous"] },
        "implementation_evidence": { "type": "string", "minLength": 1 },
        "failure_consequence": { "type": ["string", "null"] },
        "school_agreement_needed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practice_id", "title_ru", "classification", "legal_basis", "notes"],
      "properties": {
        "practice_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title_ru": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": [
            "nationally_required",
            "required_by_individual_curriculum",
            "school_specific",
            "recommended_good_practice",
            "commercial_product_feature",
            "not_verified"
          ]
        },
        "legal_basis": { "type": ["string", "null"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "declared_complete",
        "declared_scope",
        "checked_documents",
        "checked_appendices",
        "excluded_scope",
        "known_gaps",
        "verification_date",
        "next_review_due"
      ],
      "properties": {
        "status": { "enum": ["verified", "partial", "missing", "ambiguous"] },
        "declared_complete": { "type": "boolean" },
        "declared_scope": { "type": "string", "minLength": 1 },
        "checked_documents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "checked_appendices": { "type": "array", "items": { "type": "string" } },
        "excluded_scope": { "type": "array", "items": { "type": "string" } },
        "known_gaps": { "type": "array", "items": { "type": "string" } },
        "verification_date": { "$ref": "#/$defs/date" },
        "next_review_due": { "$ref": "#/$defs/date" }
      }
    }
  }
}
