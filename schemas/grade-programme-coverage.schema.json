{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/grade-programme-coverage.schema.json",
  "title": "Opiq Helper Grade 4 coverage matrices",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/routeCoverage" },
    { "$ref": "#/$defs/programmeCoverage" }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "school_stage", "terminal_grade", "exact_grade_claimed"],
          "properties": {
            "kind": { "const": "school_stage" },
            "school_stage": { "const": 2 },
            "terminal_grade": { "const": 6 },
            "exact_grade_claimed": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "grade", "exact_grade_claimed"],
          "properties": {
            "kind": { "const": "exact_grade" },
            "grade": { "const": 4 },
            "exact_grade_claimed": { "const": true }
          }
        }
      ]
    },
    "coverageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "official_scope",
        "curated_grade_4_allocation",
        "curriculum_alignment_status",
        "source_topic_presence",
        "task_evidence_status",
        "full_prose_status",
        "lesson_authoring_status",
        "assessment_evidence_status",
        "coverage_status",
        "route_ids",
        "topic_cluster_refs",
        "blocking_gaps"
      ],
      "properties": {
        "outcome_id": { "$ref": "#/$defs/slug" },
        "official_scope": { "$ref": "#/$defs/scope" },
        "curated_grade_4_allocation": {
          "enum": [
            "opiq_helper_recommended_allocation",
            "local_school_allocation_candidate",
            "official_exact_grade"
          ]
        },
        "curriculum_alignment_status": {
          "enum": ["verified", "partial", "missing", "ambiguous"]
        },
        "source_topic_presence": {
          "enum": ["heading_only", "heading_and_task_example", "metadata_only", "missing", "ambiguous"]
        },
        "task_evidence_status": { "enum": ["partial", "missing", "ambiguous"] },
        "full_prose_status": { "const": "missing" },
        "lesson_authoring_status": { "const": "not_started" },
        "assessment_evidence_status": { "enum": ["partial", "missing", "ambiguous"] },
        "coverage_status": { "enum": ["partial", "missing", "ambiguous"] },
        "route_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "topic_cluster_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "blocking_gaps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        }
      }
    },
    "routeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "artifact_id",
        "grade",
        "route_id",
        "official_curriculum_ref",
        "topic_inventory_ref",
        "rows",
        "summary",
        "completeness"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "grade_programme_route_coverage" },
        "artifact_id": { "$ref": "#/$defs/slug" },
        "grade": { "const": 4 },
        "route_id": { "$ref": "#/$defs/slug" },
        "official_curriculum_ref": { "$ref": "#/$defs/repositoryPath" },
        "topic_inventory_ref": { "$ref": "#/$defs/repositoryPath" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/coverageRow" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome_count", "partial", "missing", "ambiguous", "verified_full_coverage"],
          "properties": {
            "outcome_count": { "type": "integer", "minimum": 1 },
            "partial": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "ambiguous": { "type": "integer", "minimum": 0 },
            "verified_full_coverage": { "const": 0 }
          }
        },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "declared_complete", "known_gaps"],
          "properties": {
            "status": { "const": "partial" },
            "declared_complete": { "const": false },
            "known_gaps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "programmeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "artifact_id",
        "programme_id",
        "target_school_year",
        "outcome_index_ref",
        "rows",
        "missing_exclusive_route_fields",
        "summary",
        "completeness"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "grade_programme_coverage_matrix" },
        "artifact_id": { "$ref": "#/$defs/slug" },
        "programme_id": { "$ref": "#/$defs/slug" },
        "target_school_year": { "const": "2026/27" },
        "outcome_index_ref": { "const": "compliance/estonia/2026-27/outcome-index.yaml" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/coverageRow" }
        },
        "missing_exclusive_route_fields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["art", "technology_craft_home_economics", "physical_education"] }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official_outcome_count",
            "route_linked_outcomes",
            "missing_route_outcomes",
            "exact_grade_outcomes",
            "school_stage_outcomes"
          ],
          "properties": {
            "official_outcome_count": { "type": "integer", "minimum": 1 },
            "route_linked_outcomes": { "type": "integer", "minimum": 1 },
            "missing_route_outcomes": { "type": "integer", "minimum": 3 },
            "exact_grade_outcomes": { "const": 2 },
            "school_stage_outcomes": { "type": "integer", "minimum": 1 }
          }
        },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "declared_complete", "known_gaps"],
          "properties": {
            "status": { "const": "partial" },
            "declared_complete": { "const": false },
            "known_gaps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    }
  }
}
