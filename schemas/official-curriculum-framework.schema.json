{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/schemas/official-curriculum-framework.schema.json",
  "title": "Official curriculum framework and outcome sets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "framework_id",
    "target_school_year",
    "source_registry_ref",
    "scope_model",
    "outcome_sets",
    "completeness"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "official_curriculum_framework" },
    "framework_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "target_school_year": { "const": "2026/27" },
    "source_registry_ref": { "$ref": "#/$defs/repositoryPath" },
    "scope_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "national_general_requirements",
        "school_stage_outcomes",
        "exact_grade_only_when_explicit",
        "school_allocation_is_local",
        "publisher_sequence_is_supporting"
      ],
      "properties": {
        "national_general_requirements": { "const": true },
        "school_stage_outcomes": { "const": true },
        "exact_grade_only_when_explicit": { "const": true },
        "school_allocation_is_local": { "const": true },
        "publisher_sequence_is_supporting": { "const": true }
      }
    },
    "outcome_sets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outcomeSet" }
    },
    "completeness": { "$ref": "#/$defs/completeness" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "school_stage", "terminal_grade", "exact_grade_claimed"],
          "properties": {
            "kind": { "const": "school_stage" },
            "school_stage": { "enum": [1, 2] },
            "terminal_grade": { "enum": [3, 6] },
            "exact_grade_claimed": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "grade", "exact_grade_claimed"],
          "properties": {
            "kind": { "const": "exact_grade" },
            "grade": { "enum": [2, 4] },
            "exact_grade_claimed": { "const": true }
          }
        }
      ]
    },
    "translationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_language", "verified_on", "notes"],
      "properties": {
        "kind": { "enum": ["opiq_helper_translation", "official_translation"] },
        "source_language": { "const": "et" },
        "verified_on": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_or_requirement_id",
        "source_id",
        "official_reference",
        "official_wording_et",
        "translation_ru",
        "translation_provenance",
        "scope",
        "requirement_kind",
        "evidence_status",
        "effective_from",
        "effective_to",
        "verified_on",
        "verification_notes",
        "downstream_relevance"
      ],
      "properties": {
        "outcome_or_requirement_id": {
          "type": "string",
          "pattern": "^ee-(?:prk|plrk)-2026-(?:stage[12]|grade[24])-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "official_reference": { "type": "string", "minLength": 1 },
        "official_wording_et": { "type": "string", "minLength": 1 },
        "translation_ru": { "type": "string", "minLength": 1 },
        "translation_provenance": { "$ref": "#/$defs/translationProvenance" },
        "scope": { "$ref": "#/$defs/scope" },
        "requirement_kind": {
          "enum": [
            "general_competency",
            "subject_field_outcome",
            "subject_outcome",
            "cross_curricular_theme",
            "assessment_principle",
            "school_curriculum_allocation"
          ]
        },
        "evidence_status": { "enum": ["verified", "partial", "missing", "ambiguous"] },
        "effective_from": { "$ref": "#/$defs/date" },
        "effective_to": {
          "oneOf": [
            { "$ref": "#/$defs/date" },
            { "type": "null" }
          ]
        },
        "verified_on": { "$ref": "#/$defs/date" },
        "verification_notes": { "type": "string", "minLength": 1 },
        "downstream_relevance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grade_2", "grade_4", "route_ids"],
          "properties": {
            "grade_2": { "type": "boolean" },
            "grade_4": { "type": "boolean" },
            "route_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          }
        }
      }
    },
    "outcomeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_set_id",
        "curriculum",
        "subject_field",
        "official_subject",
        "scope",
        "source_ids",
        "outcomes"
      ],
      "properties": {
        "outcome_set_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "curriculum": { "enum": ["ordinary", "simplified"] },
        "subject_field": { "type": "string", "minLength": 1 },
        "official_subject": { "type": ["string", "null"] },
        "scope": { "$ref": "#/$defs/scope" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "declared_complete",
        "declared_scope",
        "checked_documents",
        "checked_appendices",
        "excluded_scope",
        "known_gaps",
        "verification_date",
        "next_review_due"
      ],
      "properties": {
        "status": { "enum": ["verified", "partial", "missing", "ambiguous"] },
        "declared_complete": { "type": "boolean" },
        "declared_scope": { "type": "string", "minLength": 1 },
        "checked_documents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "checked_appendices": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "excluded_scope": { "type": "array", "items": { "type": "string" } },
        "known_gaps": { "type": "array", "items": { "type": "string" } },
        "verification_date": { "$ref": "#/$defs/date" },
        "next_review_due": { "$ref": "#/$defs/date" }
      }
    }
  }
}
