{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/teacher-work-plan-reusable-artifact.schema.json",
  "title": "Teacher work-plan reusable artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "package_id",
    "implementation_status",
    "identity",
    "canonical_route",
    "source_work_package",
    "source_gaps",
    "teacher_plan_source",
    "learner_language_profile",
    "content_boundary",
    "opiq_context_records",
    "lesson_sequence",
    "language_support",
    "safety_and_ethics",
    "materials",
    "content_fingerprint",
    "human_review",
    "readiness",
    "source_gap_support"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "teacher_work_plan_reusable_artifact" },
    "artifact_id": { "const": "grade-6-science-soil-organisms" },
    "package_id": { "const": "grade-6-science-soil-organisms" },
    "implementation_status": { "const": "internal_draft_pending_teacher_review" },
    "identity": { "$ref": "#/$defs/identity" },
    "canonical_route": { "$ref": "#/$defs/canonicalRoute" },
    "source_work_package": { "$ref": "#/$defs/sourceWorkPackage" },
    "source_gaps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/sourceGap" }
    },
    "teacher_plan_source": { "$ref": "#/$defs/teacherPlanSource" },
    "learner_language_profile": { "$ref": "#/$defs/languageProfile" },
    "content_boundary": { "$ref": "#/$defs/contentBoundary" },
    "opiq_context_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/opiqContext" }
    },
    "lesson_sequence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/lessonPart" }
    },
    "language_support": { "$ref": "#/$defs/languageSupport" },
    "safety_and_ethics": { "$ref": "#/$defs/safetyEthics" },
    "materials": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/material" }
    },
    "content_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "human_review": { "$ref": "#/$defs/humanReview" },
    "readiness": { "$ref": "#/$defs/readiness" },
    "source_gap_support": { "$ref": "#/$defs/sourceGapSupport" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "subject", "subject_et", "title_ru", "title_et", "instruction_language", "subject_support_language"],
      "properties": {
        "grade": { "const": 6 },
        "subject": { "const": "science" },
        "subject_et": { "const": "loodusõpetus" },
        "title_ru": { "const": "Почвенные организмы: наблюдение и объяснение" },
        "title_et": { "const": "Mullaorganismid: vaatlus ja selgitamine" },
        "instruction_language": { "const": "ru" },
        "subject_support_language": { "const": "et" }
      }
    },
    "canonicalRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "md_path", "source_archive", "qa_path", "record_count", "coverage_status"],
      "properties": {
        "source_id": { "const": "grade-6-science" },
        "md_path": { "const": "project-files/outputs/opiq_6klass_loodusopetus.md" },
        "source_archive": { "const": "project-files/inputs/final-zips/opiq_6klass_elutingimused_soos_v2.zip" },
        "qa_path": { "const": "project-files/outputs/opiq_6klass_loodusopetus_qa.json" },
        "record_count": { "const": 436 },
        "coverage_status": { "const": "available_not_curriculum_verified" }
      }
    },
    "capability": {
      "enum": ["teacher_guide", "practical_protocol", "observation_table", "student_worksheet", "answer_key", "assessment_rubric", "oral_support"]
    },
    "sourceWorkPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "review_path", "package_id", "authoring_status", "priority_tier", "selected_as_first_pilot", "planned_root_path", "proposed_deliverables"],
      "properties": {
        "review_id": { "const": "grades-5-7-priority-work-packages" },
        "review_path": { "const": "evaluations/teacher-work-plans/grades-5-7-priority-work-packages.yaml" },
        "package_id": { "const": "grade-6-science-soil-organisms" },
        "authoring_status": { "const": "ready_for_authoring" },
        "priority_tier": { "const": "p0" },
        "selected_as_first_pilot": { "const": true },
        "planned_root_path": { "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms" },
        "proposed_deliverables": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "lessonSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_start", "lesson_end"],
      "properties": {
        "lesson_start": { "type": "integer", "minimum": 1 },
        "lesson_end": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "mapping_id", "source_record_kind", "source_block_id", "lesson_span", "source_pages", "source_topic_et", "normalized_mapping_topic_et", "coverage_status", "bridge_type", "topic_inventory_refs"],
      "properties": {
        "gap_id": { "enum": ["grade-6-science-lesson-008", "grade-6-science-lesson-009"] },
        "mapping_id": { "enum": ["lesson-008", "lesson-009"] },
        "source_record_kind": { "const": "lesson_range" },
        "source_block_id": { "const": "muld" },
        "lesson_span": { "$ref": "#/$defs/lessonSpan" },
        "source_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "source_topic_et": { "$ref": "#/$defs/nonEmptyString" },
        "normalized_mapping_topic_et": { "$ref": "#/$defs/nonEmptyString" },
        "coverage_status": { "const": "missing" },
        "bridge_type": { "enum": ["independently_authored_practical_required", "independently_authored_bridge_required"] },
        "topic_inventory_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "soil-formation-and-properties" }
        }
      }
    },
    "teacherPlanSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_path", "source_pdf_path", "original_filename", "source_sha256", "source_page_count", "relevant_source_pages", "provenance_kind", "canonical"],
      "properties": {
        "extraction_path": { "const": "evaluations/teacher-work-plans/grade-6-science-extraction.json" },
        "source_pdf_path": { "const": "project-files/inputs/originals/teacher-work-plans/Loodusopetuse-tookava-naidis-6-klassile.pdf" },
        "original_filename": { "const": "Loodusõpetuse-töökava-näidis-6.-klassile.pdf" },
        "source_sha256": { "const": "2b63ada1c2821e63a8aadda0bf93246499c2f8430cd305592a82a709a0160762" },
        "source_page_count": { "const": 31 },
        "relevant_source_pages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": [3, 4] }
        },
        "provenance_kind": { "const": "supplementary_teacher_work_plan" },
        "canonical": { "const": false }
      }
    },
    "languageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_path", "learner_language_level", "expected_supported_estonian_output_sentences"],
      "properties": {
        "profile_id": { "const": "grade-6-science-a2-default" },
        "profile_path": { "const": "lesson-plans/language-profiles.yaml" },
        "learner_language_level": { "const": "A2" },
        "expected_supported_estonian_output_sentences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "const": 3 },
            "maximum": { "const": 5 }
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "contentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opiq_required", "customer_or_learner_can_complete_without_opiq", "external_sources_used", "live_catalogue_checked", "pupil_facing_science_provenance", "teacher_plan_contribution", "teacher_plan_does_not_supply", "direct_opiq_soil_organism_evidence_available"],
      "properties": {
        "opiq_required": { "const": false },
        "customer_or_learner_can_complete_without_opiq": { "const": true },
        "external_sources_used": { "const": false },
        "live_catalogue_checked": { "const": false },
        "pupil_facing_science_provenance": { "const": "independently_authored" },
        "teacher_plan_contribution": { "$ref": "#/$defs/stringList" },
        "teacher_plan_does_not_supply": { "$ref": "#/$defs/stringList" },
        "direct_opiq_soil_organism_evidence_available": { "const": false }
      }
    },
    "opiqContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_bucket", "topic_inventory_ref", "record_id", "canonical_url", "canonical_source_id", "book_id", "title", "language", "programme_type", "programme_type_evidence_status", "default_course_eligibility", "instructional_roles", "relationship_to_pilot", "required_for_learner_completion"],
      "properties": {
        "inventory_bucket": { "enum": ["selected_records", "alternative_records"] },
        "topic_inventory_ref": { "const": "soil-formation-and-properties" },
        "record_id": { "$ref": "#/$defs/slug" },
        "canonical_url": { "type": "string", "pattern": "^https://www\\.opiq\\.ee/kit/[0-9]+/chapter/[0-9]+$" },
        "canonical_source_id": { "const": "grade-6-science" },
        "book_id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "enum": ["et", "ru"] },
        "programme_type": { "const": "unknown" },
        "programme_type_evidence_status": { "const": "ambiguous" },
        "default_course_eligibility": { "const": "unverified" },
        "instructional_roles": { "$ref": "#/$defs/stringList" },
        "relationship_to_pilot": { "enum": ["soil_context_only_not_soil_organism_evidence", "soil_context_only_not_soil_organism_protocol"] },
        "required_for_learner_completion": { "const": false }
      }
    },
    "lessonPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "source_gap_id", "title_ru", "title_et", "duration_minutes", "primary_outputs"],
      "properties": {
        "part_id": { "enum": ["part-1", "part-2"] },
        "source_gap_id": { "enum": ["grade-6-science-lesson-008", "grade-6-science-lesson-009"] },
        "title_ru": { "$ref": "#/$defs/nonEmptyString" },
        "title_et": { "$ref": "#/$defs/nonEmptyString" },
        "duration_minutes": { "const": 45 },
        "primary_outputs": { "$ref": "#/$defs/stringList" }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["et", "ru"],
      "properties": {
        "et": { "$ref": "#/$defs/nonEmptyString" },
        "ru": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "languageSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "represented_as_opiq_oral_evidence", "productive_terms", "sentence_frames", "full_russian_model_answer_required"],
      "properties": {
        "provenance": { "const": "independently_authored_language_support" },
        "represented_as_opiq_oral_evidence": { "const": false },
        "productive_terms": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/term" }
        },
        "sentence_frames": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "full_russian_model_answer_required": { "const": true }
      }
    },
    "safetyEthics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_teacher_risk_assessment_required", "universal_safety_claimed", "protected_area_permission_is_teacher_responsibility", "safeguards", "scientific_boundaries", "indoor_fallback_available"],
      "properties": {
        "local_teacher_risk_assessment_required": { "const": true },
        "universal_safety_claimed": { "const": false },
        "protected_area_permission_is_teacher_responsibility": { "const": true },
        "safeguards": { "$ref": "#/$defs/stringList" },
        "scientific_boundaries": { "$ref": "#/$defs/stringList" },
        "indoor_fallback_available": { "const": true }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "capability", "title", "artifact_path", "audience", "languages", "printable", "provenance", "sha256"],
      "properties": {
        "material_id": { "$ref": "#/$defs/slug" },
        "capability": { "$ref": "#/$defs/capability" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_path": { "$ref": "#/$defs/repositoryPath" },
        "audience": { "enum": ["teacher", "student", "shared"] },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["ru", "et"] }
        },
        "printable": { "const": true },
        "provenance": { "enum": ["independently_authored", "independently_authored_language_support"] },
        "answer_key_path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "index_included"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "$ref": "#/$defs/sha256" },
        "index_included": { "const": false }
      }
    },
    "humanReviewChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completed_record_path"],
      "properties": {
        "status": { "const": "pending" },
        "completed_record_path": { "const": null }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_path",
        "teacher_review",
        "local_safety_review",
        "classroom_trial",
        "reviewed_content_fingerprint"
      ],
      "properties": {
        "registry_path": {
          "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/reviews/review-registry.yaml"
        },
        "teacher_review": { "$ref": "#/$defs/humanReviewChannel" },
        "local_safety_review": { "$ref": "#/$defs/humanReviewChannel" },
        "classroom_trial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_created", "template_path", "status", "completed_record_path"],
          "properties": {
            "workflow_created": { "const": true },
            "template_path": {
              "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/reviews/classroom-trial-template.yaml"
            },
            "status": { "const": "not_tested" },
            "completed_record_path": { "const": null }
          }
        },
        "reviewed_content_fingerprint": { "const": null }
      }
    },
    "statusOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "$ref": "#/$defs/nonEmptyString" } }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_complete", "content_complete_for_internal_review", "materials_resolved", "print_ready", "teacher_review", "local_safety_review", "classroom_trial", "classroom_ready", "publication_ready", "customer_released", "effectiveness_claimed"],
      "properties": {
        "schema_complete": { "const": true },
        "content_complete_for_internal_review": { "const": true },
        "materials_resolved": { "const": true },
        "print_ready": { "const": true },
        "teacher_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "pending" } }
        },
        "local_safety_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "status"],
          "properties": {
            "required": { "const": true },
            "status": { "const": "pending" }
          }
        },
        "classroom_trial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "not_tested" } }
        },
        "classroom_ready": { "const": false },
        "publication_ready": { "const": false },
        "customer_released": { "const": false },
        "effectiveness_claimed": { "const": false }
      }
    },
    "sourceGapSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independently_authored_support_created", "supported_gap_ids", "canonical_opiq_gap_status_unchanged", "source_gap_resolution_claimed", "official_curriculum_complete", "annual_architecture_created", "default_course_selection_complete", "live_catalogue_complete"],
      "properties": {
        "independently_authored_support_created": { "const": true },
        "supported_gap_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["grade-6-science-lesson-008", "grade-6-science-lesson-009"] }
        },
        "canonical_opiq_gap_status_unchanged": { "const": true },
        "source_gap_resolution_claimed": { "const": false },
        "official_curriculum_complete": { "const": false },
        "annual_architecture_created": { "const": false },
        "default_course_selection_complete": { "const": false },
        "live_catalogue_complete": { "const": false }
      }
    }
  }
}
