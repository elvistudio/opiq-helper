{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-intake.schema.json",
  "title": "Offline pedagogical human-evidence JSON intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "kind",
    "pack_path",
    "prepared_for_date",
    "privacy_notice",
    "non_guarantees",
    "record"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "pedagogical_evidence_intake" },
    "kind": { "enum": ["teacher-review", "classroom-trial", "home-trial"] },
    "pack_path": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/repositoryPath" },
    "prepared_for_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "privacy_notice": { "type": "string", "minLength": 1 },
    "non_guarantees": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "record": {
      "oneOf": [
        { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teacher-review.schema.json" },
        { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/classroom-trial.schema.json" },
        { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/home-trial.schema.json" }
      ]
    }
  }
}
