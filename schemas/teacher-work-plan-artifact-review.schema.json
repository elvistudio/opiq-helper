{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/teacher-work-plan-artifact-review.schema.json",
  "title": "Teacher work-plan reusable-artifact human review",
  "oneOf": [
    { "$ref": "#/$defs/reviewRegistry" },
    { "$ref": "#/$defs/teacherReview" },
    { "$ref": "#/$defs/localSafetyReview" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableString": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullableSlug": {
      "oneOf": [
        { "$ref": "#/$defs/slug" },
        { "type": "null" }
      ]
    },
    "areaId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "dateOrNull": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        { "type": "null" }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_index_path",
        "content_fingerprint",
        "package_id",
        "route",
        "grade",
        "subject",
        "subject_et"
      ],
      "properties": {
        "artifact_id": { "const": "grade-6-science-soil-organisms" },
        "artifact_index_path": {
          "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/artifact-index.yaml"
        },
        "content_fingerprint": {
          "const": "894cc83f54c158485f6d6ba699d8a1298c3e57056e315281b79d69e84f366613"
        },
        "package_id": { "const": "grade-6-science-soil-organisms" },
        "route": { "const": "grade-6-science" },
        "grade": { "const": 6 },
        "subject": { "const": "science" },
        "subject_et": { "const": "loodusõpetus" }
      }
    },
    "reviewIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "reviewer_id",
        "reviewer_name",
        "reviewer_role",
        "organization",
        "review_date"
      ],
      "properties": {
        "review_id": { "$ref": "#/$defs/nullableSlug" },
        "reviewer_id": { "$ref": "#/$defs/nullableSlug" },
        "reviewer_name": { "$ref": "#/$defs/nullableString" },
        "reviewer_role": { "$ref": "#/$defs/nullableString" },
        "organization": { "$ref": "#/$defs/nullableString" },
        "review_date": { "$ref": "#/$defs/dateOrNull" }
      }
    },
    "scopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "status", "notes", "finding_ids"],
      "properties": {
        "area": { "$ref": "#/$defs/areaId" },
        "status": {
          "enum": ["not_reviewed", "acceptable", "change_required", "blocking_issue"]
        },
        "notes": { "$ref": "#/$defs/nullableString" },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "teacherScope": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "scientific_accuracy" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "age_appropriateness" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "instructional_clarity" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "practical_feasibility" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "assessment_alignment" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "russian_explanation_quality" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "estonian_language_support" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "accessibility_and_differentiation" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "source_and_provenance_boundaries" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "readiness_claims" } } }] }
      ],
      "items": false
    },
    "safetyScope": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "school_or_site_context" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "exact_observation_locations" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "weather_and_terrain" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "restricted_or_protected_area_permissions" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "hazardous_objects_and_waste" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "organisms_and_allergy_risks" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "tools_and_gloves" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "hygiene_and_handwashing" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "accessibility_and_participation" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "supervision_and_stop_signals" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "indoor_fallback" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "emergency_or_incident_procedure" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scopeItem" }, { "properties": { "area": { "const": "restoration_and_ethical_return" } } }] }
      ],
      "items": false
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "area",
        "description",
        "required_change",
        "affected_paths",
        "status",
        "resolution_notes"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/slug" },
        "severity": { "enum": ["note", "minor", "major", "blocking"] },
        "area": { "$ref": "#/$defs/areaId" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "required_change": { "$ref": "#/$defs/nullableString" },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "status": { "enum": ["open", "resolved", "accepted_risk"] },
        "resolution_notes": { "$ref": "#/$defs/nullableString" }
      }
    },
    "teacherDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "open_blocking_findings",
        "open_major_findings",
        "required_changes_complete",
        "reviewed_fingerprint_matches"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "approved_with_nonblocking_changes",
            "changes_required",
            "rejected"
          ]
        },
        "rationale": { "$ref": "#/$defs/nullableString" },
        "open_blocking_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "open_major_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "required_changes_complete": { "type": "boolean" },
        "reviewed_fingerprint_matches": { "type": "boolean" }
      }
    },
    "safetyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "open_blocking_findings",
        "open_major_findings",
        "required_changes_complete",
        "reviewed_fingerprint_matches",
        "conditions"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved_for_named_context",
            "approved_with_conditions",
            "changes_required",
            "rejected"
          ]
        },
        "rationale": { "$ref": "#/$defs/nullableString" },
        "open_blocking_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "open_major_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "required_changes_complete": { "type": "boolean" },
        "reviewed_fingerprint_matches": { "type": "boolean" },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "reviewChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_path", "completed_record_paths", "status"],
      "properties": {
        "template_path": { "$ref": "#/$defs/repositoryPath" },
        "completed_record_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "status": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reviewRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "registry_id",
        "artifact_id",
        "artifact_index_path",
        "content_fingerprint",
        "teacher_review",
        "local_safety_review",
        "classroom_trial",
        "boundaries"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "teacher_work_plan_artifact_review_registry" },
        "registry_id": { "const": "grade-6-science-soil-organisms-review-registry" },
        "artifact_id": { "const": "grade-6-science-soil-organisms" },
        "artifact_index_path": {
          "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/artifact-index.yaml"
        },
        "content_fingerprint": {
          "const": "894cc83f54c158485f6d6ba699d8a1298c3e57056e315281b79d69e84f366613"
        },
        "teacher_review": {
          "allOf": [
            { "$ref": "#/$defs/reviewChannel" },
            {
              "properties": {
                "template_path": {
                  "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/reviews/teacher-review-template.yaml"
                },
                "status": {
                  "enum": ["pending", "approved", "approved_with_nonblocking_changes", "changes_required", "rejected"]
                }
              }
            }
          ]
        },
        "local_safety_review": {
          "allOf": [
            { "$ref": "#/$defs/reviewChannel" },
            {
              "properties": {
                "template_path": {
                  "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/reviews/local-safety-review-template.yaml"
                },
                "status": {
                  "enum": ["pending", "approved_for_named_context", "approved_with_conditions", "changes_required", "rejected"]
                }
              }
            }
          ]
        },
        "classroom_trial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template_path", "completed_record_paths", "status"],
          "properties": {
            "template_path": {
              "const": "teacher-work-plan-artifacts/grade-6-science/soil-organisms/reviews/classroom-trial-template.yaml"
            },
            "completed_record_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/repositoryPath" }
            },
            "status": {
              "enum": [
                "not_tested",
                "successful",
                "successful_with_notes",
                "repeat_trial_required",
                "unsuccessful"
              ]
            }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classroom_trial_workflow_created",
            "review_complete",
            "local_safety_review_complete",
            "classroom_trial_complete",
            "classroom_ready",
            "publication_ready",
            "customer_released",
            "effectiveness_claimed"
          ],
          "properties": {
            "classroom_trial_workflow_created": { "const": true },
            "review_complete": { "type": "boolean" },
            "local_safety_review_complete": { "type": "boolean" },
            "classroom_trial_complete": { "type": "boolean" },
            "classroom_ready": { "type": "boolean" },
            "publication_ready": { "const": false },
            "customer_released": { "const": false },
            "effectiveness_claimed": { "const": false }
          }
        }
      }
    },
    "teacherReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "template",
        "review_identity",
        "artifact_identity",
        "review_scope",
        "findings",
        "decision"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "teacher_work_plan_artifact_teacher_review" },
        "template": { "type": "boolean" },
        "review_identity": { "$ref": "#/$defs/reviewIdentity" },
        "artifact_identity": { "$ref": "#/$defs/artifactIdentity" },
        "review_scope": { "$ref": "#/$defs/teacherScope" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "decision": { "$ref": "#/$defs/teacherDecision" }
      },
      "allOf": [
        {
          "if": { "properties": { "template": { "const": true } }, "required": ["template"] },
          "then": {
            "properties": {
              "review_identity": {
                "properties": {
                  "review_id": { "const": null },
                  "reviewer_id": { "const": null },
                  "reviewer_name": { "const": null },
                  "reviewer_role": { "const": null },
                  "organization": { "const": null },
                  "review_date": { "const": null }
                }
              },
              "review_scope": {
                "items": { "properties": { "status": { "const": "not_reviewed" } } }
              },
              "findings": { "maxItems": 0 },
              "decision": {
                "properties": {
                  "status": { "const": "pending" },
                  "rationale": { "const": null },
                  "open_blocking_findings": { "maxItems": 0 },
                  "open_major_findings": { "maxItems": 0 },
                  "required_changes_complete": { "const": false },
                  "reviewed_fingerprint_matches": { "const": false }
                }
              }
            }
          }
        }
      ]
    },
    "localContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "school_or_organization",
        "site_description",
        "planned_activity_date",
        "group_size",
        "adult_supervision_count",
        "weather_limitations",
        "accessibility_adjustments",
        "permission_requirements",
        "emergency_contact_process"
      ],
      "properties": {
        "school_or_organization": { "$ref": "#/$defs/nullableString" },
        "site_description": { "$ref": "#/$defs/nullableString" },
        "planned_activity_date": { "$ref": "#/$defs/dateOrNull" },
        "group_size": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "adult_supervision_count": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "weather_limitations": { "$ref": "#/$defs/nullableString" },
        "accessibility_adjustments": { "$ref": "#/$defs/nullableString" },
        "permission_requirements": { "$ref": "#/$defs/nullableString" },
        "emergency_contact_process": { "$ref": "#/$defs/nullableString" }
      }
    },
    "safetyBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "named_context_only",
        "universal_safety_claimed",
        "other_site_legal_permission_claimed",
        "all_weather_approval_claimed",
        "protected_area_permission_claimed",
        "classroom_readiness_claimed"
      ],
      "properties": {
        "named_context_only": { "const": true },
        "universal_safety_claimed": { "const": false },
        "other_site_legal_permission_claimed": { "const": false },
        "all_weather_approval_claimed": { "const": false },
        "protected_area_permission_claimed": { "const": false },
        "classroom_readiness_claimed": { "const": false }
      }
    },
    "localSafetyReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "template",
        "review_identity",
        "artifact_identity",
        "local_context",
        "review_scope",
        "findings",
        "decision",
        "safety_boundaries"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "teacher_work_plan_artifact_local_safety_review" },
        "template": { "type": "boolean" },
        "review_identity": { "$ref": "#/$defs/reviewIdentity" },
        "artifact_identity": { "$ref": "#/$defs/artifactIdentity" },
        "local_context": { "$ref": "#/$defs/localContext" },
        "review_scope": { "$ref": "#/$defs/safetyScope" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "decision": { "$ref": "#/$defs/safetyDecision" },
        "safety_boundaries": { "$ref": "#/$defs/safetyBoundaries" }
      },
      "allOf": [
        {
          "if": { "properties": { "template": { "const": true } }, "required": ["template"] },
          "then": {
            "properties": {
              "review_identity": {
                "properties": {
                  "review_id": { "const": null },
                  "reviewer_id": { "const": null },
                  "reviewer_name": { "const": null },
                  "reviewer_role": { "const": null },
                  "organization": { "const": null },
                  "review_date": { "const": null }
                }
              },
              "local_context": {
                "properties": {
                  "school_or_organization": { "const": null },
                  "site_description": { "const": null },
                  "planned_activity_date": { "const": null },
                  "group_size": { "const": null },
                  "adult_supervision_count": { "const": null },
                  "weather_limitations": { "const": null },
                  "accessibility_adjustments": { "const": null },
                  "permission_requirements": { "const": null },
                  "emergency_contact_process": { "const": null }
                }
              },
              "review_scope": {
                "items": { "properties": { "status": { "const": "not_reviewed" } } }
              },
              "findings": { "maxItems": 0 },
              "decision": {
                "properties": {
                  "status": { "const": "pending" },
                  "rationale": { "const": null },
                  "open_blocking_findings": { "maxItems": 0 },
                  "open_major_findings": { "maxItems": 0 },
                  "required_changes_complete": { "const": false },
                  "reviewed_fingerprint_matches": { "const": false },
                  "conditions": { "maxItems": 0 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
