{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/schemas/curriculum-change-note.schema.json",
  "title": "Curriculum and compliance change note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "change_note_id",
    "from_school_year",
    "to_school_year",
    "verified_on",
    "comparisons",
    "known_gaps"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "curriculum_change_note" },
    "change_note_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "from_school_year": { "const": "2025/26" },
    "to_school_year": { "const": "2026/27" },
    "verified_on": { "type": "string", "const": "2026-07-28" },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comparison_id",
          "title_ru",
          "status",
          "previous_source_id",
          "target_source_id",
          "effective_from",
          "summary_ru",
          "official_references"
        ],
        "properties": {
          "comparison_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title_ru": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "unchanged",
              "changed",
              "newly_effective_2026_09_01",
              "removed",
              "renumbered",
              "ambiguous",
              "implementation_only_change"
            ]
          },
          "previous_source_id": { "type": ["string", "null"] },
          "target_source_id": { "type": "string", "minLength": 1 },
          "effective_from": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
          "summary_ru": { "type": "string", "minLength": 1 },
          "comparison_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "algorithm",
              "previous_value",
              "target_value",
              "item_count",
              "identities_match"
            ],
            "properties": {
              "method": { "const": "ordered_attachment_name_and_sha256" },
              "algorithm": { "const": "sha256" },
              "previous_value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "target_value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "item_count": { "type": "integer", "minimum": 1 },
              "identities_match": { "type": "boolean" }
            }
          },
          "official_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "known_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
