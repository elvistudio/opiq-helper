{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json",
  "title": "Opiq Helper shared teaching-plan vocabulary",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "canonicalRoute": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/course-map.schema.json#/$defs/canonicalRoute"
    },
    "pageRecord": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/course-map.schema.json#/$defs/pageRecord"
    },
    "provenance": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/course-map.schema.json#/$defs/provenance"
    },
    "learnerLanguageLevel": {
      "enum": ["A1", "A1-A2", "A2", "A2-B1", "B1"]
    },
    "methodologyApproach": {
      "enum": [
        "content_language_dual_objectives",
        "planned_translanguaging",
        "gradual_scaffolding",
        "pluriliteracies",
        "multimodal_support",
        "vocabulary_recycling",
        "cognitive_load_control",
        "separate_content_language_assessment"
      ]
    },
    "languageFunction": {
      "enum": [
        "name",
        "describe",
        "compare",
        "classify",
        "sequence",
        "explain",
        "infer",
        "conclude",
        "report"
      ]
    },
    "scaffoldLevel": {
      "enum": ["full_support", "partial_support", "short_independent_output"]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "materialLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["ru", "et"] }
    },
    "pedagogicalReviewLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guide_path", "review_record_path", "status"],
      "properties": {
        "guide_path": { "$ref": "#/$defs/repositoryPath" },
        "review_record_path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/repositoryPath" }
          ]
        },
        "status": { "enum": ["pending", "changes_requested", "approved", "rejected"] }
      }
    },
    "classroomTrialLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_path", "trial_record_paths", "status"],
      "properties": {
        "template_path": { "$ref": "#/$defs/repositoryPath" },
        "trial_record_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "status": { "enum": ["not_tested", "changes_required", "repeat_required", "tested"] }
      }
    },
    "authorMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "title",
        "material_type",
        "artifact_path",
        "audience",
        "languages",
        "printable",
        "provenance"
      ],
      "properties": {
        "material_id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "material_type": {
          "enum": [
            "explanation",
            "bridge",
            "worksheet",
            "assessment",
            "visual",
            "practical_setup",
            "teacher_guide",
            "lesson_guide",
            "checklist",
            "rubric",
            "homeschool_guide",
            "answer_key",
            "parent_guide",
            "pack_overview"
          ]
        },
        "artifact_path": { "$ref": "#/$defs/repositoryPath" },
        "audience": { "enum": ["teacher", "student", "parent", "shared"] },
        "languages": { "$ref": "#/$defs/materialLanguages" },
        "printable": { "type": "boolean" },
        "answer_key_path": { "$ref": "#/$defs/repositoryPath" },
        "answer_key_exemption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["open_ended", "reason"],
          "properties": {
            "open_ended": { "const": true },
            "reason": { "type": "string", "minLength": 10 }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "material_type": { "enum": ["worksheet", "assessment"] }
            },
            "required": ["material_type"]
          },
          "then": {
            "oneOf": [
              {
                "required": ["answer_key_path"],
                "properties": { "answer_key_path": true }
              },
              {
                "required": ["answer_key_exemption"],
                "properties": { "answer_key_exemption": true }
              }
            ]
          }
        }
      ]
    },
    "artifactReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_complete",
        "content_complete",
        "materials_resolved",
        "print_ready",
        "teacher_review",
        "classroom_trial",
        "classroom_ready",
        "readiness_status"
      ],
      "properties": {
        "schema_complete": { "type": "boolean" },
        "content_complete": { "type": "boolean" },
        "materials_resolved": { "type": "boolean" },
        "print_ready": { "type": "boolean" },
        "teacher_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer_role", "reviewed_at", "notes"],
          "properties": {
            "status": { "enum": ["pending", "approved", "changes_requested"] },
            "reviewer_role": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "minLength": 1 }
              ]
            },
            "reviewed_at": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "minLength": 10 }
              ]
            },
            "notes": { "type": "string", "minLength": 10 }
          }
        },
        "classroom_trial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tested_at", "context", "notes"],
          "properties": {
            "status": { "enum": ["not_tested", "tested"] },
            "tested_at": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "minLength": 10 }
              ]
            },
            "context": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "minLength": 1 }
              ]
            },
            "notes": { "type": "string", "minLength": 10 }
          }
        },
        "classroom_ready": { "type": "boolean" },
        "readiness_status": {
          "enum": [
            "draft",
            "schema_complete",
            "content_complete",
            "materials_resolved",
            "print_ready",
            "teacher_pack_complete_pending_review",
            "teacher_reviewed",
            "classroom_tested",
            "classroom_ready"
          ]
        }
      }
    },
    "newTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_et",
        "equivalent_ru",
        "simple_definition_et",
        "provenance",
        "first_use_stage",
        "reuse_stage_refs"
      ],
      "properties": {
        "term_et": { "$ref": "#/$defs/nonEmptyString" },
        "equivalent_ru": { "$ref": "#/$defs/nonEmptyString" },
        "simple_definition_et": { "type": "string", "minLength": 3 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "first_use_stage": { "$ref": "#/$defs/slug" },
        "reuse_stage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "recycledTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_et", "equivalent_ru", "source_lesson_id", "reuse_stage_refs"],
      "properties": {
        "term_et": { "$ref": "#/$defs/nonEmptyString" },
        "equivalent_ru": { "$ref": "#/$defs/nonEmptyString" },
        "source_lesson_id": { "$ref": "#/$defs/nonEmptyString" },
        "reuse_stage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "newInstructionVerb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb_et", "equivalent_ru", "provenance", "first_use_stage", "reuse_stage_refs"],
      "properties": {
        "verb_et": { "$ref": "#/$defs/nonEmptyString" },
        "equivalent_ru": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "first_use_stage": { "$ref": "#/$defs/slug" },
        "reuse_stage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "recycledInstructionVerb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb_et", "equivalent_ru", "source_lesson_id", "reuse_stage_refs"],
      "properties": {
        "verb_et": { "$ref": "#/$defs/nonEmptyString" },
        "equivalent_ru": { "$ref": "#/$defs/nonEmptyString" },
        "source_lesson_id": { "$ref": "#/$defs/nonEmptyString" },
        "reuse_stage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "objectiveReference": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "completenessStatus": {
      "enum": ["verified", "partial", "missing", "ambiguous"]
    }
  }
}
