{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/lesson-originality-review-bundle.schema.json",
  "title": "Grade 2 lesson originality review bundle",
  "oneOf": [
    {
      "$ref": "#/$defs/bundle"
    },
    {
      "$ref": "#/$defs/index"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value",
        "file_count",
        "lesson_projection_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "lesson-originality-review-v1"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "lesson_projection_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bundleFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "lesson-review-bundle-v1"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "coveredFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "material_ids",
        "audience",
        "content_roles",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "material_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "audience": {
          "enum": [
            "student",
            "teacher",
            "parent",
            "shared"
          ]
        },
        "content_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "taskDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "review_id",
        "review_path",
        "status",
        "content_fingerprint"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/slug"
        },
        "review_id": {
          "$ref": "#/$defs/slug"
        },
        "review_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "status": {
          "enum": [
            "pending",
            "changes_requested",
            "approved",
            "rejected"
          ]
        },
        "content_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_ids",
        "route_md_paths",
        "canonical_record_ids",
        "canonical_urls",
        "source_limitations"
      ],
      "properties": {
        "route_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "route_md_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "canonical_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "canonical_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://www\\.opiq\\.ee/"
          }
        },
        "source_limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "reviewDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wording_independence",
        "context_independence",
        "data_independence",
        "sequence_and_scaffolding_independence",
        "options_and_distractors_independence",
        "answer_and_solution_independence",
        "language_bridge_independence",
        "visual_and_interaction_independence"
      ],
      "properties": {
        "wording_independence": {
          "const": "needs_human_decision"
        },
        "context_independence": {
          "const": "needs_human_decision"
        },
        "data_independence": {
          "const": "needs_human_decision"
        },
        "sequence_and_scaffolding_independence": {
          "const": "needs_human_decision"
        },
        "options_and_distractors_independence": {
          "const": "needs_human_decision"
        },
        "answer_and_solution_independence": {
          "const": "needs_human_decision"
        },
        "language_bridge_independence": {
          "const": "needs_human_decision"
        },
        "visual_and_interaction_independence": {
          "const": "needs_human_decision"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "review_id",
        "lesson_id",
        "module_id",
        "lesson_path",
        "review_status",
        "reviewer",
        "reviewer_role",
        "reviewed_on",
        "reviewed_version",
        "content_fingerprint",
        "commercial_gate_fingerprint",
        "bundle_fingerprint",
        "approval_eligible",
        "blocking_review_ids",
        "covered_files",
        "covered_material_ids",
        "source_context",
        "task_dependencies",
        "review_dimensions",
        "human_review_required",
        "publication_unlocks",
        "customer_visibility_unlocks",
        "notes"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "artifact_type": {
          "const": "lesson_originality_review_bundle"
        },
        "review_id": {
          "$ref": "#/$defs/slug"
        },
        "lesson_id": {
          "$ref": "#/$defs/slug"
        },
        "module_id": {
          "const": "grade-2-weather-water-safety-pilot"
        },
        "lesson_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "review_status": {
          "const": "pending"
        },
        "reviewer": {
          "type": "null"
        },
        "reviewer_role": {
          "type": "null"
        },
        "reviewed_on": {
          "type": "null"
        },
        "reviewed_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit_sha"
          ],
          "properties": {
            "commit_sha": {
              "type": "null"
            }
          }
        },
        "content_fingerprint": {
          "$ref": "#/$defs/contentFingerprint"
        },
        "bundle_fingerprint": {
          "$ref": "#/$defs/bundleFingerprint"
        },
        "approval_eligible": {
          "type": "boolean"
        },
        "blocking_review_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "covered_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coveredFile"
          }
        },
        "covered_material_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "source_context": {
          "$ref": "#/$defs/sourceContext"
        },
        "task_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskDependency"
          }
        },
        "review_dimensions": {
          "$ref": "#/$defs/reviewDimensions"
        },
        "human_review_required": {
          "const": true
        },
        "publication_unlocks": {
          "const": false
        },
        "customer_visibility_unlocks": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 10
        },
        "commercial_gate_fingerprint": {
          "$ref": "#/$defs/commercialFingerprint"
        }
      }
    },
    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "review_id",
        "bundle_path",
        "packet_path",
        "content_fingerprint",
        "commercial_gate_fingerprint",
        "bundle_fingerprint",
        "review_status",
        "approval_eligible",
        "blocking_review_ids"
      ],
      "properties": {
        "lesson_id": {
          "$ref": "#/$defs/slug"
        },
        "review_id": {
          "$ref": "#/$defs/slug"
        },
        "bundle_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "packet_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "content_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "bundle_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "review_status": {
          "const": "pending"
        },
        "approval_eligible": {
          "type": "boolean"
        },
        "blocking_review_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "commercial_gate_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "module_id",
        "review_completion_status",
        "approved_count",
        "pending_count",
        "bundles",
        "shared_content_scope_note"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "artifact_type": {
          "const": "lesson_originality_review_index"
        },
        "module_id": {
          "const": "grade-2-weather-water-safety-pilot"
        },
        "review_completion_status": {
          "const": "pending_human_review"
        },
        "approved_count": {
          "const": 0
        },
        "pending_count": {
          "const": 4
        },
        "bundles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/indexEntry"
          }
        },
        "shared_content_scope_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "commercialFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "specification_version",
        "value",
        "file_count"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "specification_version": {
          "const": "1.0"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
