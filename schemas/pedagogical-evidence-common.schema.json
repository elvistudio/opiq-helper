{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json",
  "title": "Shared pedagogical human-evidence contracts",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idOrTemplateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:-YYYY-MM-DD)?$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!\\./)(?!.*//)(?!.*\\/$).+$"
    },
    "nullableDate": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    },
    "contentFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "specification_version", "value", "file_count"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "specification_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "file_count": { "type": "integer", "minimum": 1 }
      }
    },
    "lessonDnaDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "digest"],
      "properties": {
        "lesson_id": { "$ref": "#/$defs/slug" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "pedagogicalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_version",
        "taxonomy_version",
        "taxonomy_digest",
        "selection_rules_version",
        "selection_rules_digest",
        "selection_engine_version",
        "lesson_dna_schema_version",
        "activity_catalog_digest",
        "homeschool_rules_version",
        "homeschool_rules_digest",
        "homeschool_engine_version",
        "quality_engine_version",
        "quality_catalogue_version",
        "quality_catalogue_digest",
        "integration_version",
        "unit_content_identity",
        "lesson_dna_digests"
      ],
      "properties": {
        "snapshot_version": { "const": "1.1" },
        "taxonomy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "taxonomy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selection_rules_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "selection_rules_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selection_engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "lesson_dna_schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "activity_catalog_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "homeschool_rules_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "homeschool_rules_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "homeschool_engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "quality_engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "quality_catalogue_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "quality_catalogue_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "integration_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "unit_content_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lesson_dna_digests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lessonDnaDigest" }
        }
      }
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "content_fingerprint", "pedagogical_snapshot"],
      "properties": {
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "content_fingerprint": { "$ref": "#/$defs/contentFingerprint" },
        "pedagogical_snapshot": { "$ref": "#/$defs/pedagogicalSnapshot" }
      }
    },
    "evidenceIdentityOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/evidenceIdentity" }
      ]
    },
    "evidenceLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes"],
      "properties": {
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_student_names",
        "contains_birth_dates",
        "contains_personal_identifiers",
        "contains_addresses",
        "contains_contact_information",
        "contains_parent_contacts",
        "contains_photographs",
        "contains_recordings",
        "contains_health_data",
        "contains_special_category_data",
        "contains_identifiable_grades",
        "contains_identifiable_profiles",
        "contains_identifiable_free_text",
        "observations_are_aggregated",
        "identity_storage",
        "free_text_checked_for_identifiers"
      ],
      "properties": {
        "contains_student_names": { "const": false },
        "contains_birth_dates": { "const": false },
        "contains_personal_identifiers": { "const": false },
        "contains_addresses": { "const": false },
        "contains_contact_information": { "const": false },
        "contains_parent_contacts": { "const": false },
        "contains_photographs": { "const": false },
        "contains_recordings": { "const": false },
        "contains_health_data": { "const": false },
        "contains_special_category_data": { "const": false },
        "contains_identifiable_grades": { "const": false },
        "contains_identifiable_profiles": { "const": false },
        "contains_identifiable_free_text": { "const": false },
        "observations_are_aggregated": { "const": true },
        "identity_storage": { "const": "external" },
        "free_text_checked_for_identifiers": { "type": "boolean" }
      }
    },
    "deliveryModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["classroom", "homeschool"] }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "category",
        "delivery_modes",
        "artifact_paths",
        "lesson_ids",
        "phase_ids",
        "target_ids",
        "description",
        "evidence",
        "recommended_action",
        "resolution_status",
        "resolution_refs"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/slug" },
        "severity": { "enum": ["blocking", "major", "minor", "observation"] },
        "category": {
          "enum": [
            "method_suitability",
            "lesson_pattern",
            "timing",
            "setup_transition_cleanup",
            "cognitive_load",
            "language_load",
            "russian_explanation",
            "estonian_support",
            "retrieval",
            "spacing",
            "correction",
            "instruction_clarity",
            "classroom_feasibility",
            "homeschool_feasibility",
            "parent_role",
            "differentiation",
            "accessibility",
            "assessment",
            "learner_autonomy",
            "motivation",
            "safety",
            "materials",
            "artificial_or_repetitive_method",
            "learning_evidence",
            "privacy",
            "other"
          ]
        },
        "delivery_modes": { "$ref": "#/$defs/deliveryModes" },
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "lesson_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "phase_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/nonEmptyString" },
        "recommended_action": { "$ref": "#/$defs/nonEmptyString" },
        "resolution_status": { "enum": ["open", "planned", "resolved", "dismissed"] },
        "resolution_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "categoricalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "phase_ids", "rating", "summary"],
      "properties": {
        "lesson_id": { "$ref": "#/$defs/slug" },
        "phase_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "rating": { "enum": ["not_observed", "not_met", "partly_met", "met", "exceeded"] },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "finding_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "aggregate_count": { "type": "integer", "minimum": 0 },
        "aggregate_denominator": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
