{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/pedagogy-quality-report.schema.json",
  "title": "Pedagogical quality validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "report_id",
    "quality_engine_version",
    "gate_catalogue",
    "scope",
    "content_identities",
    "teacher_pack_fingerprint",
    "checked_artifacts",
    "gate_results",
    "diagnostics",
    "counts",
    "structural_status",
    "claims",
    "non_guarantees",
    "readiness",
    "determinism"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "pedagogy_quality_report" },
    "report_id": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
    },
    "quality_engine_version": { "const": "1.0" },
    "gate_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "digest"],
      "properties": {
        "path": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
        },
        "version": { "const": "1.0" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_path",
        "integrated_lesson_count",
        "legacy_lesson_count",
        "unrelated_artifacts_changed"
      ],
      "properties": {
        "requested_path": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
            }
          ]
        },
        "integrated_lesson_count": { "type": "integer", "minimum": 0 },
        "legacy_lesson_count": { "type": "integer", "minimum": 0 },
        "unrelated_artifacts_changed": { "const": false }
      }
    },
    "content_identities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identity" }
    },
    "teacher_pack_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "specification_version", "value", "file_count"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "specification_version": { "const": "1.0" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "file_count": { "type": "integer", "minimum": 1 }
      }
    },
    "checked_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
      }
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gateResult" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "info", "passed", "excepted", "not_applicable"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "excepted": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 }
      }
    },
    "structural_status": {
      "enum": ["failed", "pass_with_warnings", "passed"]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pedagogy_schema_valid", "structurally_complete"],
      "properties": {
        "pedagogy_schema_valid": { "type": "boolean" },
        "structurally_complete": { "type": "boolean" }
      }
    },
    "non_guarantees": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10 }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teacher_review",
        "classroom_trial",
        "home_trial",
        "classroom_ready",
        "homeschool_ready",
        "effectiveness_claimed"
      ],
      "properties": {
        "teacher_review": { "const": "pending" },
        "classroom_trial": { "const": "not_tested" },
        "home_trial": { "const": "not_started" },
        "classroom_ready": { "const": false },
        "homeschool_ready": { "const": false },
        "effectiveness_claimed": { "const": false }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_ai",
        "no_network",
        "no_randomness",
        "no_current_timestamps",
        "ordering"
      ],
      "properties": {
        "no_ai": { "const": true },
        "no_network": { "const": true },
        "no_randomness": { "const": true },
        "no_current_timestamps": { "const": true },
        "ordering": { "const": "bytewise" }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "algorithm", "value"],
      "properties": {
        "record_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_version",
        "artifact_path",
        "record_id",
        "status"
      ],
      "properties": {
        "gate_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "gate_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "artifact_path": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
        },
        "record_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "status": {
          "enum": ["error", "excepted", "info", "not_applicable", "passed", "warning"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_version",
        "severity",
        "code",
        "message",
        "artifact_path",
        "record_id"
      ],
      "properties": {
        "gate_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "gate_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "severity": { "enum": ["error", "info", "warning"] },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": { "type": "string", "minLength": 10 },
        "artifact_path": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
        },
        "record_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "related_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
          }
        },
        "expected": {},
        "actual": {},
        "exception_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        }
      }
    }
  }
}
