{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/task-bank-index.schema.json",
  "title": "Strict task-bank relationship index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "index_id",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "task_bank_index" },
    "index_id": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specification_id",
          "specification_path",
          "task_id",
          "task_path",
          "originality_review_id",
          "originality_review_path",
          "grade",
          "subject",
          "official_outcome_ids",
          "publication_status",
          "current_fingerprint",
          "current_fingerprint_status"
        ],
        "properties": {
          "specification_id": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
          },
          "specification_path": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
          },
          "task_id": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
          },
          "task_path": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
          },
          "originality_review_id": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
          },
          "originality_review_path": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath"
          },
          "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
          "subject": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "official_outcome_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
            }
          },
          "publication_status": {
            "enum": [
              "internal_draft",
              "internal_review",
              "publication_ready",
              "customer_released"
            ]
          },
          "current_fingerprint": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/contentFingerprint"
          },
          "current_fingerprint_status": {
            "enum": ["current_pending_review", "current_approved", "stale"]
          }
        }
      }
    }
  }
}
