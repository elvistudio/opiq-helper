{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/home-trial.schema.json",
  "title": "Opiq Helper privacy-safe homeschool pedagogical trial record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "trial_id",
    "pack_ref",
    "evidence_identity",
    "trial_status",
    "context",
    "privacy",
    "conducted_at",
    "session_observations",
    "instruction_comprehension",
    "adult_role",
    "learner_independence",
    "material_availability",
    "offline_and_printer_assumptions",
    "retrieval_and_correction",
    "language_scaffolds",
    "practical_safety",
    "task_completion",
    "recall_and_transfer",
    "findings",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "home_trial" },
    "trial_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/idOrTemplateId" },
    "pack_ref": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" },
    "evidence_identity": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/evidenceIdentityOrNull" },
    "trial_status": { "enum": ["draft", "conducted", "analysed", "superseded"] },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_ids", "setting", "grade", "learner_count", "study_context", "delivery_mode", "adult_role", "family_identity_storage"],
      "properties": {
        "lesson_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" }
        },
        "setting": { "const": "homeschool" },
        "grade": { "type": "integer", "minimum": 1 },
        "learner_count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "study_context": { "enum": ["individual_study", "collaborative_study"] },
        "delivery_mode": { "enum": ["homeschool", "independent_study", "parent_supported", "remote"] },
        "adult_role": { "enum": ["none", "logistical_support", "listening_partner", "check_answers", "active_participant", "safety_supervision"] },
        "family_identity_storage": { "const": "external" }
      }
    },
    "privacy": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/privacy" },
    "conducted_at": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/nullableDate" },
    "session_observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/sessionObservation" }
    },
    "instruction_comprehension": { "$ref": "#/$defs/observationArray" },
    "adult_role": { "$ref": "#/$defs/observationArray" },
    "learner_independence": { "$ref": "#/$defs/observationArray" },
    "material_availability": { "$ref": "#/$defs/observationArray" },
    "offline_and_printer_assumptions": { "$ref": "#/$defs/observationArray" },
    "retrieval_and_correction": { "$ref": "#/$defs/observationArray" },
    "language_scaffolds": { "$ref": "#/$defs/observationArray" },
    "practical_safety": { "$ref": "#/$defs/observationArray" },
    "task_completion": { "$ref": "#/$defs/observationArray" },
    "recall_and_transfer": { "$ref": "#/$defs/observationArray" },
    "findings": {
      "type": "array",
      "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/finding" }
    },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "$defs": {
    "observationArray": {
      "type": "array",
      "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/categoricalObservation" }
    },
    "sessionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "planned_minutes", "actual_minutes", "unplanned_adult_support", "parent_role_bounded", "summary"],
      "properties": {
        "lesson_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" },
        "planned_minutes": { "type": "integer", "minimum": 0 },
        "actual_minutes": { "type": "integer", "minimum": 0 },
        "unplanned_adult_support": { "enum": ["none", "minimal", "low", "medium", "high", "intensive"] },
        "parent_role_bounded": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "safe_to_repeat", "parent_role_remained_bounded", "rationale"],
      "properties": {
        "status": { "enum": ["pending", "changes_required", "repeat_trial_required", "successful_with_notes", "successful"] },
        "safe_to_repeat": {
          "oneOf": [
            { "type": "null" },
            { "type": "boolean" }
          ]
        },
        "parent_role_remained_bounded": {
          "oneOf": [
            { "type": "null" },
            { "type": "boolean" }
          ]
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
