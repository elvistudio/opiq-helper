{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/teacher-review.schema.json",
  "title": "Opiq Helper independent teacher review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "review_id",
    "pack_ref",
    "reviewed_version",
    "review_status",
    "reviewer",
    "reviewed_at",
    "review_scope",
    "ratings",
    "findings",
    "blocking_findings",
    "required_changes",
    "optional_improvements",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "artifact_type": { "const": "teacher_review" },
    "review_id": { "$ref": "#/$defs/idOrTemplateId" },
    "pack_ref": { "$ref": "#/$defs/slug" },
    "reviewed_version": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/reviewedVersion" },
    "review_status": { "enum": ["draft", "completed", "superseded"] },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "reviewed_at": { "$ref": "#/$defs/nullableDate" },
    "review_scope": { "$ref": "#/$defs/reviewScope" },
    "ratings": { "$ref": "#/$defs/ratings" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "blocking_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "required_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "optional_improvements": {
      "type": "array",
      "items": { "$ref": "#/$defs/improvement" }
    },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "idOrTemplateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:-YYYY-MM-DD)?$"
    },
    "nullableDate": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "subject_experience_years", "language_context", "identity_storage", "reviewer_reference"],
      "properties": {
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "subject_experience_years": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "language_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction_language", "subject_support_language"],
          "properties": {
            "instruction_language": { "const": "ru" },
            "subject_support_language": { "const": "et" }
          }
        },
        "identity_storage": { "const": "external" },
        "reviewer_reference": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        }
      }
    },
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher_guide", "lesson_guides", "student_materials", "answer_keys", "assessment_rubric", "homeschool_materials", "safety", "language_level"],
      "properties": {
        "teacher_guide": { "type": "boolean" },
        "lesson_guides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "student_materials": { "type": "boolean" },
        "answer_keys": { "type": "boolean" },
        "assessment_rubric": { "type": "boolean" },
        "homeschool_materials": { "type": "boolean" },
        "safety": { "type": "boolean" },
        "language_level": { "type": "boolean" }
      }
    },
    "nullableRating": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 5 }
      ]
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific_accuracy", "age_appropriateness", "timing_feasibility", "instruction_clarity", "student_material_usability", "assessment_alignment", "estonian_a1_a2_fit", "safety_readiness", "homeschool_usability"],
      "properties": {
        "scientific_accuracy": { "$ref": "#/$defs/nullableRating" },
        "age_appropriateness": { "$ref": "#/$defs/nullableRating" },
        "timing_feasibility": { "$ref": "#/$defs/nullableRating" },
        "instruction_clarity": { "$ref": "#/$defs/nullableRating" },
        "student_material_usability": { "$ref": "#/$defs/nullableRating" },
        "assessment_alignment": { "$ref": "#/$defs/nullableRating" },
        "estonian_a1_a2_fit": { "$ref": "#/$defs/nullableRating" },
        "safety_readiness": { "$ref": "#/$defs/nullableRating" },
        "homeschool_usability": { "$ref": "#/$defs/nullableRating" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "category", "artifact_paths", "lesson_ids", "description", "evidence", "recommended_action", "resolution_status", "resolution_refs"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/slug" },
        "severity": { "enum": ["blocking", "major", "minor", "observation"] },
        "category": {
          "enum": ["scientific_accuracy", "curriculum_alignment", "age_appropriateness", "timing", "instruction_clarity", "safety", "student_material", "answer_key", "assessment", "estonian_language_level", "russian_explanation", "differentiation", "homeschool", "accessibility", "other"]
        },
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "lesson_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/nonEmptyString" },
        "recommended_action": { "$ref": "#/$defs/nonEmptyString" },
        "resolution_status": { "enum": ["open", "planned", "resolved", "dismissed"] },
        "resolution_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "finding_refs", "description", "resolution_status", "resolution_refs"],
      "properties": {
        "change_id": { "$ref": "#/$defs/slug" },
        "finding_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "resolution_status": { "enum": ["open", "planned", "resolved", "dismissed"] },
        "resolution_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["improvement_id", "description", "status", "refs"],
      "properties": {
        "improvement_id": { "$ref": "#/$defs/slug" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["proposed", "accepted", "declined", "completed"] },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": { "enum": ["pending", "changes_required", "approved_with_minor_notes", "approved", "rejected"] },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
