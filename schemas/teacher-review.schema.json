{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/teacher-review.schema.json",
  "title": "Opiq Helper pedagogical teacher review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "review_id",
    "pack_ref",
    "evidence_identity",
    "lifecycle",
    "review_status",
    "reviewer",
    "reviewed_at",
    "delivery_scopes",
    "review_scope",
    "ratings",
    "rating_applicability",
    "privacy",
    "findings",
    "blocking_findings",
    "required_changes",
    "optional_improvements",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "artifact_type": { "const": "teacher_review" },
    "review_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/idOrTemplateId" },
    "pack_ref": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" },
    "evidence_identity": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/evidenceIdentityOrNull" },
    "lifecycle": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/evidenceLifecycle" },
    "review_status": { "enum": ["draft", "completed", "superseded"] },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "subject_experience_years", "language_context", "identity_storage", "reviewer_reference"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "subject_experience_years": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "language_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction_language", "subject_support_language"],
          "properties": {
            "instruction_language": { "type": "string", "minLength": 2, "maxLength": 8 },
            "subject_support_language": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "minLength": 2, "maxLength": 8 }
              ]
            }
          }
        },
        "identity_storage": { "const": "external" },
        "reviewer_reference": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" }
          ]
        }
      }
    },
    "reviewed_at": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/nullableDate" },
    "delivery_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["classroom", "homeschool"] }
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teacher_guide",
        "lesson_guides",
        "student_materials",
        "answer_keys",
        "assessment_rubric",
        "homeschool_materials",
        "safety",
        "language_level",
        "lesson_dna",
        "selection_and_adaptation_artifacts"
      ],
      "properties": {
        "teacher_guide": { "type": "boolean" },
        "lesson_guides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" }
        },
        "student_materials": { "type": "boolean" },
        "answer_keys": { "type": "boolean" },
        "assessment_rubric": { "type": "boolean" },
        "homeschool_materials": { "type": "boolean" },
        "safety": { "type": "boolean" },
        "language_level": { "type": "boolean" },
        "lesson_dna": { "type": "boolean" },
        "selection_and_adaptation_artifacts": { "type": "boolean" }
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_suitability_for_grade",
        "method_suitability_for_subject",
        "lesson_pattern_coherence",
        "timing_realism",
        "transition_setup_cleanup_realism",
        "cognitive_load",
        "total_productive_language_load",
        "russian_primary_explanation_quality",
        "estonian_a1_a2_support_fit",
        "retrieval_quality",
        "spaced_review_usefulness",
        "correction_and_self_explanation",
        "teacher_instruction_clarity",
        "classroom_feasibility",
        "homeschool_clarity",
        "parent_role_realism",
        "differentiation",
        "inclusion_accessibility",
        "assessment_validity",
        "subject_language_assessment_separation",
        "learner_autonomy",
        "motivation_competence_support",
        "safety",
        "material_availability",
        "artificial_repetitive_method_risk"
      ],
      "properties": {
        "method_suitability_for_grade": { "$ref": "#/$defs/nullableRating" },
        "method_suitability_for_subject": { "$ref": "#/$defs/nullableRating" },
        "lesson_pattern_coherence": { "$ref": "#/$defs/nullableRating" },
        "timing_realism": { "$ref": "#/$defs/nullableRating" },
        "transition_setup_cleanup_realism": { "$ref": "#/$defs/nullableRating" },
        "cognitive_load": { "$ref": "#/$defs/nullableRating" },
        "total_productive_language_load": { "$ref": "#/$defs/nullableRating" },
        "russian_primary_explanation_quality": { "$ref": "#/$defs/nullableRating" },
        "estonian_a1_a2_support_fit": { "$ref": "#/$defs/nullableRating" },
        "retrieval_quality": { "$ref": "#/$defs/nullableRating" },
        "spaced_review_usefulness": { "$ref": "#/$defs/nullableRating" },
        "correction_and_self_explanation": { "$ref": "#/$defs/nullableRating" },
        "teacher_instruction_clarity": { "$ref": "#/$defs/nullableRating" },
        "classroom_feasibility": { "$ref": "#/$defs/nullableRating" },
        "homeschool_clarity": { "$ref": "#/$defs/nullableRating" },
        "parent_role_realism": { "$ref": "#/$defs/nullableRating" },
        "differentiation": { "$ref": "#/$defs/nullableRating" },
        "inclusion_accessibility": { "$ref": "#/$defs/nullableRating" },
        "assessment_validity": { "$ref": "#/$defs/nullableRating" },
        "subject_language_assessment_separation": { "$ref": "#/$defs/nullableRating" },
        "learner_autonomy": { "$ref": "#/$defs/nullableRating" },
        "motivation_competence_support": { "$ref": "#/$defs/nullableRating" },
        "safety": { "$ref": "#/$defs/nullableRating" },
        "material_availability": { "$ref": "#/$defs/nullableRating" },
        "artificial_repetitive_method_risk": { "$ref": "#/$defs/nullableRating" }
      }
    },
    "rating_applicability": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "rationale"],
        "properties": {
          "dimension": { "$ref": "#/$defs/ratingDimension" },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "privacy": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/privacy" },
    "findings": {
      "type": "array",
      "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/finding" }
    },
    "blocking_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" }
    },
    "required_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "optional_improvements": {
      "type": "array",
      "items": { "$ref": "#/$defs/improvement" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": { "enum": ["pending", "changes_required", "approved_with_minor_notes", "approved", "rejected"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "nullableRating": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 5 },
        { "const": "not_applicable" }
      ]
    },
    "ratingDimension": {
      "enum": [
        "method_suitability_for_grade",
        "method_suitability_for_subject",
        "lesson_pattern_coherence",
        "timing_realism",
        "transition_setup_cleanup_realism",
        "cognitive_load",
        "total_productive_language_load",
        "russian_primary_explanation_quality",
        "estonian_a1_a2_support_fit",
        "retrieval_quality",
        "spaced_review_usefulness",
        "correction_and_self_explanation",
        "teacher_instruction_clarity",
        "classroom_feasibility",
        "homeschool_clarity",
        "parent_role_realism",
        "differentiation",
        "inclusion_accessibility",
        "assessment_validity",
        "subject_language_assessment_separation",
        "learner_autonomy",
        "motivation_competence_support",
        "safety",
        "material_availability",
        "artificial_repetitive_method_risk"
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "finding_refs", "description", "resolution_status", "resolution_refs"],
      "properties": {
        "change_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" },
        "finding_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" }
        },
        "description": { "type": "string", "minLength": 1 },
        "resolution_status": { "enum": ["open", "planned", "resolved", "dismissed"] },
        "resolution_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["improvement_id", "description", "status", "refs"],
      "properties": {
        "improvement_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/pedagogical-evidence-common.schema.json#/$defs/slug" },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "accepted", "declined", "completed"] },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
