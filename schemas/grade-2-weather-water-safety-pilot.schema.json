{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/grade-2-weather-water-safety-pilot.schema.json",
  "title": "Grade 2 weather, water and safety pilot snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "module_id",
    "project_ref",
    "programme_id",
    "period_ref",
    "grade",
    "title_ru",
    "title_et",
    "implementation_status",
    "delivery",
    "source_routes",
    "lesson_contract",
    "task_bank_integration",
    "shared_product",
    "physical_education_boundary",
    "teacher_pack",
    "readiness",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "grade_2_project_module_implementation" },
    "module_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" },
    "project_ref": { "const": "grade-2-project-weather-water-safety" },
    "programme_id": { "const": "grade-2-standalone-commercial-programme-2026-27" },
    "period_ref": { "const": "programme-period-1" },
    "grade": { "const": 2 },
    "title_ru": { "const": "Погода, вода и безопасность" },
    "title_et": { "const": "Ilm, vesi ja ohutus" },
    "implementation_status": { "const": "internal_authoring_complete" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_mode",
        "opiq_required",
        "customer_can_complete_without_opiq",
        "visibility",
        "publication_status"
      ],
      "properties": {
        "core_mode": { "const": "standalone_commercial_core" },
        "opiq_required": { "const": false },
        "customer_can_complete_without_opiq": { "const": true },
        "visibility": { "const": "internal_only" },
        "publication_status": { "const": "internal_review" }
      }
    },
    "source_routes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "grade-2-science",
          "grade-2-mathematics",
          "grade-2-human-studies",
          "grade-2-russian",
          "grade-2-estonian-second-language"
        ]
      }
    },
    "lesson_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_slots",
        "authored_lesson_count",
        "planned_lesson_count",
        "slots"
      ],
      "properties": {
        "total_slots": { "const": 4 },
        "authored_lesson_count": { "const": 4 },
        "planned_lesson_count": { "const": 0 },
        "slots": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/lessonSlot" }
        }
      }
    },
    "task_bank_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "pending_internal",
        "pending_unintegrated_task_ids"
      ],
      "properties": {
        "approved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lesson_id", "task_ids", "reviewed_commit_sha"],
          "properties": {
            "lesson_id": { "const": "grade-2-weather-water-safety-02-data-time" },
            "task_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "g2-weather-data-comparison-task",
                  "g2-time-measurement-problem-task"
                ]
              }
            },
            "reviewed_commit_sha": {
              "const": "a450745bbd382c4758d7cbc96f998b27db76288e"
            }
          }
        },
        "pending_internal": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/pendingTaskGroup" }
        },
        "pending_unintegrated_task_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "g2-weather-observation-conclusion-task",
              "g2-weather-table-interpretation-task",
              "g2-weather-message-main-point-task",
              "g2-weather-instruction-sequence-task",
              "g2-estonian-follow-instruction-task",
              "g2-estonian-safety-phrase-task"
            ]
          }
        }
      }
    },
    "shared_product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "assembled_from_attributable_individual_work",
        "individual_observation_required",
        "individual_calculation_required",
        "individual_oral_output_required",
        "individual_report_contribution_required",
        "individual_exit_ticket_required",
        "report_transfer_requires_personal_code",
        "shared_evidence_replaces_individual"
      ],
      "properties": {
        "product": { "const": "weather_board_and_group_report" },
        "assembled_from_attributable_individual_work": { "const": true },
        "individual_observation_required": { "const": true },
        "individual_calculation_required": { "const": true },
        "individual_oral_output_required": { "const": true },
        "individual_report_contribution_required": { "const": true },
        "individual_exit_ticket_required": { "const": true },
        "report_transfer_requires_personal_code": { "const": true },
        "shared_evidence_replaces_individual": { "const": false }
      }
    },
    "physical_education_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_slot",
        "source_status",
        "content_strategy",
        "lesson_authoring_status",
        "human_studies_support_bounded",
        "replacement_by_human_studies_forbidden"
      ],
      "properties": {
        "lesson_slot": { "const": 3 },
        "source_status": { "const": "missing_route" },
        "content_strategy": { "const": "author_created_required" },
        "lesson_authoring_status": { "const": "authored_internal" },
        "human_studies_support_bounded": { "const": true },
        "replacement_by_human_studies_forbidden": { "const": true }
      }
    },
    "teacher_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "materials_index_path"],
      "properties": {
        "path": { "const": "teacher-packs/grade-2/weather-water-safety" },
        "materials_index_path": {
          "const": "teacher-packs/grade-2/weather-water-safety/materials-index.yaml"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_complete",
        "module_complete",
        "release_ready",
        "teacher_approved",
        "classroom_trial",
        "home_trial",
        "effectiveness_claimed"
      ],
      "properties": {
        "authoring_complete": { "const": true },
        "module_complete": { "const": true },
        "release_ready": { "const": false },
        "teacher_approved": { "const": false },
        "classroom_trial": { "const": "not_tested" },
        "home_trial": { "const": "not_started" },
        "effectiveness_claimed": { "const": false }
      }
    },
    "claim_boundary": { "type": "string", "minLength": 30 }
  },
  "$defs": {
    "pendingTaskGroup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lesson_id",
            "task_fingerprints",
            "publication_unlocks",
            "customer_visibility_unlocks"
          ],
          "properties": {
            "lesson_id": { "const": "grade-2-weather-water-safety-03-safe-decisions" },
            "task_fingerprints": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/pendingTask09Fingerprint" },
                  { "$ref": "#/$defs/pendingTask10Fingerprint" }
                ]
              }
            },
            "publication_unlocks": { "const": false },
            "customer_visibility_unlocks": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lesson_id",
            "task_fingerprints",
            "publication_unlocks",
            "customer_visibility_unlocks"
          ],
          "properties": {
            "lesson_id": { "const": "grade-2-weather-water-safety-04-weather-report" },
            "task_fingerprints": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/pendingTask11Fingerprint" },
                  { "$ref": "#/$defs/pendingTask12Fingerprint" }
                ]
              }
            },
            "publication_unlocks": { "const": false },
            "customer_visibility_unlocks": { "const": false }
          }
        }
      ]
    },
    "pendingTaskFingerprint": {
      "oneOf": [
        { "$ref": "#/$defs/pendingTask09Fingerprint" },
        { "$ref": "#/$defs/pendingTask10Fingerprint" },
        { "$ref": "#/$defs/pendingTask11Fingerprint" },
        { "$ref": "#/$defs/pendingTask12Fingerprint" }
      ]
    },
    "pendingTask09Fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "value"],
      "properties": {
        "task_id": { "const": "g2-water-edge-safe-decision-task" },
        "value": { "const": "a9fa9e4c5d80cc5de79c886e82e19a79eb2042a679b1a5db96ae0f85ba40cee3" }
      }
    },
    "pendingTask10Fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "value"],
      "properties": {
        "task_id": { "const": "g2-pe-water-safety-decision-task" },
        "value": { "const": "1d81778b9e7767e1b239b65b28e5ead76bb05ee08c4756f03777d13b7695c922" }
      }
    },
    "pendingTask11Fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "value"],
      "properties": {
        "task_id": { "const": "g2-shared-weather-report-contribution-task" },
        "value": { "const": "303d0dc6c06e02f2aef83c38ed9fb024b1e89e00aa43195451c1645d851b90c0" }
      }
    },
    "pendingTask12Fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "value"],
      "properties": {
        "task_id": { "const": "g2-weather-exit-ticket-task" },
        "value": { "const": "b72ab93feeda22c38dce62e6b3c2c74c5500194f32e5ba8c0df2c63cf2ab3bc1" }
      }
    },
    "lessonSlot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "status",
            "lesson_id",
            "lesson_path",
            "title_ru",
            "title_et",
            "primary_subject",
            "canonical_route_id",
            "content_complete",
            "release_ready"
          ],
          "properties": {
            "position": { "enum": [1, 2, 3, 4] },
            "status": { "const": "authored_internal" },
            "lesson_id": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug" },
            "lesson_path": { "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/repositoryPath" },
            "title_ru": { "type": "string", "minLength": 3 },
            "title_et": { "type": "string", "minLength": 3 },
            "primary_subject": { "enum": ["science", "mathematics", "human_studies"] },
            "canonical_route_id": { "enum": ["grade-2-science", "grade-2-mathematics", "grade-2-human-studies"] },
            "content_complete": { "const": true },
            "release_ready": { "const": false }
          }
        }
      ]
    }
  }
}
