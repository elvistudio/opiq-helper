{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvistudio.github.io/opiq-helper/schemas/external-source-registry.schema.json",
  "title": "Opiq Helper external source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "registry_id", "sources", "notes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "external_source_registry" },
    "registry_id": {
      "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalSource" }
    },
    "notes": { "type": "string", "minLength": 10 }
  },
  "$defs": {
    "sourceCategory": {
      "enum": [
        "official_public_source",
        "scientific_or_university_source",
        "museum_or_recognized_educational_source",
        "reputable_educational_or_environmental_source"
      ]
    },
    "externalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "organization",
        "url",
        "source_category",
        "source_language",
        "verified_on",
        "instructional_purpose",
        "related_topic_or_unit_ids",
        "official_curriculum_evidence",
        "notes",
        "provenance"
      ],
      "properties": {
        "source_id": {
          "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
        },
        "title": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "source_category": { "$ref": "#/$defs/sourceCategory" },
        "source_language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "verified_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "instructional_purpose": { "type": "string", "minLength": 10 },
        "related_topic_or_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://elvistudio.github.io/opiq-helper/schemas/teaching-plan-common.schema.json#/$defs/slug"
          }
        },
        "official_curriculum_evidence": { "const": false },
        "notes": { "type": "string", "minLength": 10 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_family", "source_type", "source_reference", "notes"],
          "properties": {
            "source_family": { "const": "external" },
            "source_type": { "$ref": "#/$defs/sourceCategory" },
            "source_reference": { "type": "string", "minLength": 1 },
            "notes": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
