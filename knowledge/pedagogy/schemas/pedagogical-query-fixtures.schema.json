{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-query-fixtures.schema.json",
  "title": "Pedagogical activity filtering fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "taxonomy_version",
    "selection_mode",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "pedagogical_query_fixtures"
    },
    "taxonomy_version": {
      "const": "1.0"
    },
    "selection_mode": {
      "const": "deterministic_filtering_without_ranking"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "taxonomyIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/taxonomyId"
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "subject"
      ],
      "properties": {
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "subject": {
          "enum": [
            "arts_and_crafts",
            "cross_curricular",
            "geography",
            "human_studies",
            "language_learning",
            "mathematics",
            "music",
            "science"
          ]
        },
        "lesson_phase": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/lessonPhase"
        },
        "delivery_mode": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/deliveryMode"
        },
        "group_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "group_size_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "group_formats_any": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/groupFormat"
          }
        },
        "required_capabilities_all": {
          "$ref": "#/$defs/taxonomyIdList"
        },
        "required_capabilities_any": {
          "$ref": "#/$defs/taxonomyIdList"
        },
        "minimum_capability_level": {
          "enum": [
            "incidental",
            "supporting",
            "primary"
          ]
        },
        "max_parent_effort": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/effortLevel"
        },
        "max_teacher_preparation": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/effortLevel"
        },
        "offline": {
          "type": "boolean"
        },
        "no_printer": {
          "type": "boolean"
        },
        "adult_safety_supervision_required": {
          "type": "boolean"
        },
        "max_productive_language": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/demandLevel"
        },
        "estonian_a1_a2_compatibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/estonianA1A2Compatibility"
          }
        },
        "max_duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "source_access_during_first_attempt": {
          "enum": [
            "allowed",
            "required",
            "prohibited",
            "not_applicable",
            "unknown"
          ]
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "description_ru",
        "filters",
        "expected_include_target_ids",
        "expected_exclude_target_ids",
        "ordering"
      ],
      "properties": {
        "query_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "description_ru": {
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "expected_include_target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/queryTargetId"
          }
        },
        "expected_exclude_target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/queryTargetId"
          }
        },
        "ordering": {
          "const": "target_id_bytewise"
        }
      }
    }
  }
}
