{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/homeschool-adaptation-request.schema.json",
  "title": "Homeschool adaptation request",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "request_id",
        "source",
        "adaptation_context",
        "content_bindings"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_type": {"const": "homeschool_adaptation_request"},
        "request_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_request", "lesson_dna"],
          "properties": {
            "selection_request": {"type": "object"},
            "lesson_dna": {"type": "object"}
          }
        },
        "adaptation_context": {"$ref": "#/$defs/adaptationContext"},
        "content_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contentBinding"}
        }
      }
    },
    "adaptationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "learner_count",
        "learner_session_minutes",
        "maximum_sessions",
        "resources",
        "adult_context",
        "accessibility_priorities",
        "answer_access_policy",
        "teacher_override_policy",
        "limited_adaptation_policy",
        "homeschool_preferences"
      ],
      "properties": {
        "variant": {
          "enum": ["independent", "parent_child", "remote_peer", "small_sibling_group"]
        },
        "learner_count": {"type": "integer", "minimum": 1, "maximum": 4},
        "learner_session_minutes": {"type": "integer", "minimum": 10, "maximum": 60},
        "maximum_sessions": {"type": "integer", "minimum": 1, "maximum": 10},
        "maximum_total_productive_language_demand": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/demandLevel"
        },
        "resources": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-selection-request.schema.json#/$defs/resources"
        },
        "adult_context": {"$ref": "#/$defs/adultContext"},
        "accessibility_priorities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "low_reading_load",
              "low_writing_load",
              "low_movement",
              "low_sensory_demand",
              "working_memory_support"
            ]
          }
        },
        "answer_access_policy": {"$ref": "#/$defs/answerAccessPolicy"},
        "teacher_override_policy": {
          "enum": ["require_preservation", "allow_reselection_with_warning", "reject_all"]
        },
        "limited_adaptation_policy": {
          "enum": ["disallow", "allow_with_warning"]
        },
        "homeschool_preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred_target_ids", "excluded_target_ids"],
          "properties": {
            "preferred_target_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/queryTargetId"
              }
            },
            "excluded_target_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/queryTargetId"
              }
            }
          }
        }
      }
    },
    "adultContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "max_support_minutes",
        "max_effort",
        "allowed_roles",
        "safety_supervision_available",
        "subject_explanation_available"
      ],
      "properties": {
        "available": {"type": "boolean"},
        "max_support_minutes": {"type": "integer", "minimum": 0, "maximum": 180},
        "max_effort": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/effortLevel"
        },
        "allowed_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "logistical_support",
              "listening_partner",
              "check_answers",
              "active_participant",
              "safety_supervision"
            ]
          }
        },
        "safety_supervision_available": {"type": "boolean"},
        "subject_explanation_available": {"type": "boolean"}
      }
    },
    "answerAccessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_attempt_without_answer",
        "key_release",
        "corrections_visible",
        "correction_method",
        "unresolved_question_recorded"
      ],
      "properties": {
        "first_attempt_without_answer": {"const": true},
        "key_release": {
          "enum": ["after_attempt", "adult_managed", "self_managed_after_attempt"]
        },
        "corrections_visible": {"const": true},
        "correction_method": {"const": "separate_colour"},
        "unresolved_question_recorded": {"const": true}
      }
    },
    "contentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "learner_material_refs",
        "task_refs",
        "answer_key_refs",
        "teacher_explanation_refs",
        "estonian_support_refs",
        "procedure_refs",
        "safety_refs"
      ],
      "properties": {
        "phase_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "learner_material_refs": {"$ref": "#/$defs/refList"},
        "task_refs": {"$ref": "#/$defs/refList"},
        "answer_key_refs": {"$ref": "#/$defs/refList"},
        "teacher_explanation_refs": {"$ref": "#/$defs/refList"},
        "estonian_support_refs": {"$ref": "#/$defs/refList"},
        "procedure_refs": {"$ref": "#/$defs/refList"},
        "safety_refs": {"$ref": "#/$defs/refList"}
      }
    },
    "refList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[a-z0-9._/-]*[a-z0-9])?$"
      }
    }
  }
}
