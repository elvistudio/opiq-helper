{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/lesson-dna.schema.json",
  "title": "Lesson pedagogy DNA",
  "$ref": "#/$defs/lessonDna",
  "$defs": {
    "lessonDna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "lesson_dna_id",
        "status",
        "versions",
        "context",
        "pattern",
        "phases",
        "timing",
        "assessment",
        "retrieval_plan",
        "differentiation",
        "teacher_overrides",
        "warnings",
        "known_limits"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_type": {"const": "lesson_dna"},
        "lesson_dna_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structural_state", "teacher_review", "classroom_trial", "classroom_ready", "effectiveness_claimed"],
          "properties": {
            "structural_state": {"const": "proposed"},
            "teacher_review": {"const": "pending"},
            "classroom_trial": {"const": "not_started"},
            "classroom_ready": {"const": false},
            "effectiveness_claimed": {"const": false}
          }
        },
        "versions": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-selection-decision.schema.json#/$defs/versions"},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "request_digest",
            "grade",
            "subject",
            "duration_minutes",
            "delivery_mode",
            "group_size",
            "primary_instruction_language",
            "estonian_support_level"
          ],
          "properties": {
            "request_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
            "request_digest": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-selection-decision.schema.json#/$defs/sha256"},
            "grade": {"type": "integer", "minimum": 1, "maximum": 12},
            "subject": {"type": "string", "minLength": 1},
            "duration_minutes": {"type": "integer", "minimum": 10, "maximum": 180},
            "delivery_mode": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/deliveryMode"},
            "group_size": {"type": "integer", "minimum": 1, "maximum": 60},
            "primary_instruction_language": {"enum": ["ru", "et", "en"]},
            "estonian_support_level": {"enum": ["A1-A2", "not_applicable"]}
          }
        },
        "pattern": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern_id", "selection_origin", "rationale_ru"],
          "properties": {
            "pattern_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
            "selection_origin": {"enum": ["engine_selected", "request_required", "teacher_preferred"]},
            "rationale_ru": {"type": "string", "minLength": 1}
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/phase"}
        },
        "timing": {"$ref": "#/$defs/timing"},
        "assessment": {"$ref": "#/$defs/assessment"},
        "retrieval_plan": {"$ref": "#/$defs/retrievalPlan"},
        "differentiation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scaffolds", "extensions"],
          "properties": {
            "scaffolds": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "extensions": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "teacher_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["override_id", "status", "slot_id", "target_id", "rationale_ru"],
            "properties": {
              "override_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
              "status": {"const": "accepted"},
              "slot_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
              "target_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/queryTargetId"},
              "rationale_ru": {"type": "string", "minLength": 1}
            }
          }
        },
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "known_limits": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["taxonomy_ratings_provisional", "selection_weights_provisional", "teacher_review_pending", "classroom_trial_not_started", "no_effectiveness_claim"]}
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "phase",
        "purpose_ru",
        "required",
        "target",
        "activity_minutes",
        "setup_minutes",
        "cleanup_minutes",
        "transition_minutes",
        "group_format",
        "capabilities",
        "source_access",
        "language_role",
        "resources",
        "safety",
        "rationale_ru"
      ],
      "properties": {
        "phase_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
        "phase": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/lessonPhase"},
        "purpose_ru": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_id", "activity_id", "execution_profile_id"],
          "properties": {
            "target_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/queryTargetId"},
            "activity_id": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"},
            "execution_profile_id": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"}
              ]
            }
          }
        },
        "activity_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
        "setup_minutes": {"type": "integer", "minimum": 0, "maximum": 60},
        "cleanup_minutes": {"type": "integer", "minimum": 0, "maximum": 60},
        "transition_minutes": {"type": "integer", "minimum": 0, "maximum": 20},
        "group_format": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/groupFormat"},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "supporting"],
          "properties": {
            "primary": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/taxonomyId"}},
            "supporting": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/taxonomyId"}}
          }
        },
        "source_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_attempt"],
          "properties": {
            "first_attempt": {"enum": ["allowed", "required", "prohibited", "not_applicable", "unknown"]}
          }
        },
        "language_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_language", "estonian_roles"],
          "properties": {
            "primary_language": {"enum": ["ru", "et", "en"]},
            "estonian_roles": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["terminology", "labels", "familiar_instruction", "sentence_frame", "short_oral_response", "short_written_response"]}
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/taxonomyId"}}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_adult_supervision", "controls_ru"],
          "properties": {
            "requires_adult_supervision": {"type": "boolean"},
            "controls_ru": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "rationale_ru": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_minutes", "setup_minutes", "cleanup_minutes", "transition_minutes", "reserve_minutes", "total_planned_minutes", "unallocated_minutes", "fits"],
      "properties": {
        "activity_minutes": {"type": "integer", "minimum": 0},
        "setup_minutes": {"type": "integer", "minimum": 0},
        "cleanup_minutes": {"type": "integer", "minimum": 0},
        "transition_minutes": {"type": "integer", "minimum": 0},
        "reserve_minutes": {"type": "integer", "minimum": 0},
        "total_planned_minutes": {"type": "integer", "minimum": 0},
        "unallocated_minutes": {"type": "integer", "minimum": 0},
        "fits": {"const": true}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separation_policy", "subject_assessment", "estonian_language_assessment"],
      "properties": {
        "separation_policy": {"const": "separate_subject_and_estonian_language_evidence"},
        "subject_assessment": {"$ref": "#/$defs/assessmentPart"},
        "estonian_language_assessment": {"$ref": "#/$defs/assessmentPart"}
      }
    },
    "assessmentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "target_phase_ids", "notes_ru"],
      "properties": {
        "enabled": {"type": "boolean"},
        "target_phase_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"}},
        "notes_ru": {"type": "string", "minLength": 1}
      }
    },
    "retrievalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate_phase_id", "correction_phase_id", "delayed"],
      "properties": {
        "immediate_phase_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"}
          ]
        },
        "correction_phase_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"}
          ]
        },
        "delayed": {
          "type": "array",
          "items": {"$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-selection-request.schema.json#/$defs/retrievalWindow"}
        }
      }
    }
  }
}
