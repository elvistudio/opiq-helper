{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json",
  "title": "Pedagogical knowledge common definitions",
  "$defs": {
    "schemaVersion": {
      "const": "1.0"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedNames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "et",
        "ru"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "et": {
          "type": "string",
          "minLength": 1
        },
        "ru": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claimOrigin": {
      "enum": [
        "source_supported",
        "common_pedagogical_knowledge",
        "project_authored_design",
        "teacher_review_pending"
      ]
    },
    "provenanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_origin",
        "statement_ru",
        "reference_ids",
        "boundary_ru"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/stableId"
        },
        "claim_origin": {
          "$ref": "#/$defs/claimOrigin"
        },
        "statement_ru": {
          "type": "string",
          "minLength": 1
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "boundary_ru": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_origin": {
                "const": "source_supported"
              }
            },
            "required": [
              "claim_origin"
            ]
          },
          "then": {
            "properties": {
              "reference_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_origin": {
                "const": "project_authored_design"
              }
            },
            "required": [
              "claim_origin"
            ]
          },
          "then": {
            "properties": {
              "reference_ids": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "provisional",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gradeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "gradeBand": {
      "enum": [
        "1-2",
        "3-4",
        "5-7",
        "8-9",
        "10-12"
      ]
    },
    "deliveryMode": {
      "enum": [
        "classroom",
        "homeschool",
        "independent_study",
        "remote",
        "parent_supported"
      ]
    },
    "lessonPhase": {
      "enum": [
        "activation",
        "orientation",
        "explanation",
        "guided_practice",
        "independent_practice",
        "collaborative_practice",
        "formative_assessment",
        "retrieval",
        "reflection",
        "consolidation",
        "homework",
        "delayed_review"
      ]
    },
    "languageDemandLevel": {
      "enum": [
        "none",
        "low",
        "moderate",
        "high"
      ]
    },
    "languageDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receptive",
        "productive",
        "interaction",
        "estonian_a1_a2_support",
        "scaffolds_ru"
      ],
      "properties": {
        "receptive": {
          "$ref": "#/$defs/languageDemandLevel"
        },
        "productive": {
          "$ref": "#/$defs/languageDemandLevel"
        },
        "interaction": {
          "$ref": "#/$defs/languageDemandLevel"
        },
        "estonian_a1_a2_support": {
          "enum": [
            "directly_suitable",
            "supported",
            "high_scaffolding_required",
            "not_recommended"
          ]
        },
        "scaffolds_ru": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "homeschoolAdaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "variants",
        "child_responsibility_ru",
        "adult_role_ru",
        "adult_safety_supervision_ru",
        "subject_teacher_responsibility_ru",
        "limitations_ru"
      ],
      "properties": {
        "status": {
          "enum": [
            "directly_suitable",
            "adaptable",
            "limited",
            "not_recommended"
          ]
        },
        "variants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "independent",
              "parent_child",
              "remote_peer",
              "small_sibling_group"
            ]
          }
        },
        "child_responsibility_ru": {
          "type": "string",
          "minLength": 1
        },
        "adult_role_ru": {
          "type": "string",
          "minLength": 1
        },
        "adult_safety_supervision_ru": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_teacher_responsibility_ru": {
          "type": "string",
          "minLength": 1
        },
        "limitations_ru": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "requires_adult_supervision",
        "controls_ru"
      ],
      "properties": {
        "risk_level": {
          "enum": [
            "none",
            "low",
            "moderate",
            "high"
          ]
        },
        "requires_adult_supervision": {
          "type": "boolean"
        },
        "controls_ru": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "grade5ScienceApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "subject",
        "instruction_language",
        "subject_support_language",
        "learner_estonian_level",
        "delivery_modes",
        "classroom_example_ru",
        "homeschool_example_ru"
      ],
      "properties": {
        "grade": {
          "const": 5
        },
        "subject": {
          "const": "science"
        },
        "instruction_language": {
          "const": "ru"
        },
        "subject_support_language": {
          "const": "et"
        },
        "learner_estonian_level": {
          "const": "A1-A2"
        },
        "delivery_modes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": {
            "const": "classroom"
          },
          "items": {
            "$ref": "#/$defs/deliveryMode"
          }
        },
        "classroom_example_ru": {
          "type": "string",
          "minLength": 1
        },
        "homeschool_example_ru": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
