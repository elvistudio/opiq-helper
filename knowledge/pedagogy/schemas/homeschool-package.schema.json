{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/homeschool-package.schema.json",
  "title": "Homeschool learner package",
  "$ref": "#/$defs/package",
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "package_id",
        "status",
        "source_identity",
        "context",
        "materials",
        "learner_plan",
        "parent_guidance_ref",
        "weekly_study_plan_ref",
        "assessment",
        "safety",
        "timing",
        "warnings",
        "known_limits"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_type": {"const": "homeschool_package"},
        "package_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structural_state",
            "teacher_review",
            "home_trial",
            "homeschool_ready",
            "effectiveness_claimed"
          ],
          "properties": {
            "structural_state": {"const": "proposed"},
            "teacher_review": {"const": "pending"},
            "home_trial": {"const": "not_started"},
            "homeschool_ready": {"const": false},
            "effectiveness_claimed": {"const": false}
          }
        },
        "source_identity": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/homeschool-adaptation-decision.schema.json#/$defs/sourceIdentity"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grade",
            "subject",
            "variant",
            "learner_count",
            "primary_instruction_language",
            "estonian_support",
            "learner_session_minutes",
            "maximum_sessions",
            "homeschool_lesson_dna_id"
          ],
          "properties": {
            "grade": {"type": "integer", "minimum": 1, "maximum": 12},
            "subject": {"type": "string", "minLength": 1},
            "variant": {
              "enum": ["independent", "parent_child", "remote_peer", "small_sibling_group"]
            },
            "learner_count": {"type": "integer", "minimum": 1, "maximum": 4},
            "primary_instruction_language": {"const": "ru"},
            "estonian_support": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "learner_level", "allowed_roles"],
              "properties": {
                "enabled": {"type": "boolean"},
                "learner_level": {"enum": ["A1-A2", "not_applicable"]},
                "allowed_roles": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "terminology",
                      "labels",
                      "familiar_instruction",
                      "sentence_frame",
                      "short_oral_response",
                      "short_written_response"
                    ]
                  }
                }
              }
            },
            "learner_session_minutes": {"type": "integer", "minimum": 10, "maximum": 60},
            "maximum_sessions": {"type": "integer", "minimum": 1, "maximum": 10},
            "homeschool_lesson_dna_id": {"type": "string", "minLength": 1}
          }
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "learner_material_refs",
            "answer_key_refs",
            "reusable_materials",
            "consumable_materials",
            "preparation_steps_ru",
            "cleanup_steps_ru"
          ],
          "properties": {
            "learner_material_refs": {"$ref": "#/$defs/refList"},
            "answer_key_refs": {"$ref": "#/$defs/refList"},
            "reusable_materials": {"$ref": "#/$defs/refList"},
            "consumable_materials": {"$ref": "#/$defs/refList"},
            "preparation_steps_ru": {"$ref": "#/$defs/stringList"},
            "cleanup_steps_ru": {"$ref": "#/$defs/stringList"}
          }
        },
        "learner_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visible_goal_ref",
            "success_criteria_refs",
            "steps",
            "breaks",
            "contingency_ru",
            "retrieval_ru",
            "self_check_ru",
            "correction_ru",
            "reflection_ru"
          ],
          "properties": {
            "visible_goal_ref": {"type": "string", "minLength": 1},
            "success_criteria_refs": {"$ref": "#/$defs/refList"},
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/learnerStep"}
            },
            "breaks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["after_step_id", "minutes", "instruction_ru"],
                "properties": {
                  "after_step_id": {"type": "string", "minLength": 1},
                  "minutes": {"type": "integer", "minimum": 1, "maximum": 15},
                  "instruction_ru": {"type": "string", "minLength": 1}
                }
              }
            },
            "contingency_ru": {"type": "string", "minLength": 1},
            "retrieval_ru": {"type": "string", "minLength": 1},
            "self_check_ru": {"type": "string", "minLength": 1},
            "correction_ru": {"type": "string", "minLength": 1},
            "reflection_ru": {"type": "string", "minLength": 1}
          }
        },
        "parent_guidance_ref": {"type": "string", "minLength": 1},
        "weekly_study_plan_ref": {"type": "string", "minLength": 1},
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_assessment", "estonian_language_assessment", "separation_policy"],
          "properties": {
            "subject_assessment": {"type": "boolean"},
            "estonian_language_assessment": {"type": "boolean"},
            "separation_policy": {"const": "separate_subject_and_estonian_language_evidence"}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_summary_ru",
            "adult_supervision_required",
            "controls_ru",
            "stop_conditions_ru",
            "teacher_authorization_required"
          ],
          "properties": {
            "risk_summary_ru": {"type": "string", "minLength": 1},
            "adult_supervision_required": {"type": "boolean"},
            "controls_ru": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "stop_conditions_ru": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "teacher_authorization_required": {"type": "boolean"}
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "learner_activity_minutes",
            "setup_minutes",
            "cleanup_minutes",
            "transition_minutes",
            "break_minutes",
            "contingency_minutes",
            "total_learner_minutes",
            "adult_minutes"
          ],
          "properties": {
            "learner_activity_minutes": {"type": "integer", "minimum": 1},
            "setup_minutes": {"type": "integer", "minimum": 0},
            "cleanup_minutes": {"type": "integer", "minimum": 0},
            "transition_minutes": {"type": "integer", "minimum": 0},
            "break_minutes": {"type": "integer", "minimum": 0},
            "contingency_minutes": {"type": "integer", "minimum": 0},
            "total_learner_minutes": {"type": "integer", "minimum": 1},
            "adult_minutes": {"type": "integer", "minimum": 0}
          }
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/homeschool-adaptation-decision.schema.json#/$defs/warning"
          }
        },
        "known_limits": {"$ref": "#/$defs/stringList"}
      }
    },
    "learnerStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "phase_id",
        "instruction_ru",
        "learner_minutes",
        "source_access",
        "adult_involvement",
        "material_refs",
        "task_refs",
        "completion_evidence_ru",
        "safety_controls_ru",
        "estonian_roles"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string", "minLength": 1},
        "instruction_ru": {"type": "string", "minLength": 1},
        "learner_minutes": {"type": "integer", "minimum": 1},
        "source_access": {"enum": ["open", "closed", "not_applicable"]},
        "adult_involvement": {
          "enum": [
            "none",
            "logistical_support",
            "listening_partner",
            "check_answers",
            "active_participant",
            "safety_supervision"
          ]
        },
        "material_refs": {"$ref": "#/$defs/refList"},
        "task_refs": {"$ref": "#/$defs/refList"},
        "completion_evidence_ru": {"type": "string", "minLength": 1},
        "safety_controls_ru": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "estonian_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "terminology",
              "labels",
              "familiar_instruction",
              "sentence_frame",
              "short_oral_response",
              "short_written_response"
            ]
          }
        }
      }
    },
    "refList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
