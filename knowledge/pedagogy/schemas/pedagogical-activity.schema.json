{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-activity.schema.json",
  "title": "Pedagogical activity catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "activities"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "pedagogical_activity_catalog"
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "names",
        "category",
        "short_description_ru",
        "pedagogical_purposes",
        "linked_principle_ids",
        "suitable_lesson_phases",
        "suitable_grades",
        "content_types",
        "subjects",
        "delivery_modes",
        "group_formats",
        "duration",
        "language_demand",
        "teacher_preparation",
        "learner_independence",
        "homeschool_adaptation",
        "materials_ru",
        "accessibility",
        "safety",
        "risks_and_misuse",
        "contraindications_ru",
        "assessment_roles",
        "source_provenance",
        "project_authored_guidance",
        "grade5_science_applicability",
        "confidence"
      ],
      "properties": {
        "activity_id": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
        },
        "names": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/localizedNames"
        },
        "category": {
          "enum": [
            "activation",
            "reading_and_comprehension",
            "retrieval_and_consolidation",
            "concept_organization",
            "collaborative_learning",
            "reflection_and_assessment",
            "error_analysis",
            "visual_and_multimodal"
          ]
        },
        "short_description_ru": {
          "type": "string",
          "minLength": 1
        },
        "pedagogical_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "activate_prior_knowledge",
              "elicit_predictions",
              "organize_concepts",
              "guide_comprehension",
              "retrieve_without_source",
              "detect_misconceptions",
              "compare_and_classify",
              "explain_reasoning",
              "collaborate",
              "practice_language",
              "reflect_on_learning",
              "plan_follow_up",
              "apply_knowledge",
              "provide_formative_evidence",
              "vary_representation"
            ]
          }
        },
        "linked_principle_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
          }
        },
        "suitable_lesson_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/lessonPhase"
          }
        },
        "suitable_grades": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/gradeRange"
        },
        "content_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "conceptual_text",
              "vocabulary",
              "process",
              "comparison",
              "classification",
              "sequence",
              "practical_observation",
              "map_and_spatial",
              "data_and_evidence",
              "misconception",
              "oral_explanation",
              "visual_representation"
            ]
          }
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cross_curricular",
              "science",
              "geography",
              "mathematics",
              "language_learning",
              "human_studies",
              "arts_and_crafts",
              "music"
            ]
          }
        },
        "delivery_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/deliveryMode"
          }
        },
        "group_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "individual",
              "pair",
              "small_group",
              "whole_class",
              "parent_child",
              "teacher_led"
            ]
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_minutes",
            "max_minutes"
          ],
          "properties": {
            "min_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 180
            },
            "max_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 180
            }
          }
        },
        "language_demand": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/languageDemand"
        },
        "teacher_preparation": {
          "enum": [
            "none",
            "low",
            "moderate",
            "high"
          ]
        },
        "learner_independence": {
          "enum": [
            "low_supported",
            "developing",
            "high"
          ]
        },
        "homeschool_adaptation": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/homeschoolAdaptation"
        },
        "materials_ru": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supports_ru",
            "barriers_ru",
            "adaptations_ru"
          ],
          "properties": {
            "supports_ru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "barriers_ru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "adaptations_ru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "safety": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/safety"
        },
        "risks_and_misuse": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "risk_id",
              "description_ru",
              "mitigation_ru"
            ],
            "properties": {
              "risk_id": {
                "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
              },
              "description_ru": {
                "type": "string",
                "minLength": 1
              },
              "mitigation_ru": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "contraindications_ru": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessment_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "formative",
              "summative_support",
              "reflection_only"
            ]
          }
        },
        "source_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/provenanceClaim"
          }
        },
        "project_authored_guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_origin",
            "implementation_steps_ru",
            "adaptation_boundary_ru"
          ],
          "properties": {
            "claim_origin": {
              "const": "project_authored_design"
            },
            "implementation_steps_ru": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "adaptation_boundary_ru": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "grade5_science_applicability": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/grade5ScienceApplicability"
        },
        "confidence": {
          "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/confidence"
        }
      }
    }
  }
}
