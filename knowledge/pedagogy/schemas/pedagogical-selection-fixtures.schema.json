{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/pedagogical-selection-request.schema.json",
  "title": "Pedagogical selection request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learner_context",
    "lesson_context",
    "language_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "learner_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "subject",
        "delivery_mode",
        "group_size",
        "lesson_duration_minutes"
      ],
      "properties": {
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "subject": {
          "type": "string"
        },
        "delivery_mode": {
          "enum": [
            "classroom",
            "homeschool",
            "independent_study",
            "parent_supported",
            "remote"
          ]
        },
        "group_size": {
          "type": "integer",
          "minimum": 1
        },
        "lesson_duration_minutes": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "lesson_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        }
      }
    },
    "language_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_instruction_language",
        "maximum_total_productive_language_demand",
        "estonian_support"
      ],
      "properties": {
        "primary_instruction_language": {
          "const": "ru"
        },
        "maximum_total_productive_language_demand": {
          "enum": [
            "none",
            "very_low",
            "low",
            "medium",
            "high",
            "very_high"
          ]
        },
        "estonian_support": {
          "$ref": "#/$defs/estonian_support"
        }
      }
    },
    "id": {
      "type": "string"
    }
  },
  "$defs": {
    "estonian_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "language",
        "learner_level",
        "allowed_roles",
        "subject_explanation_language",
        "sentence_frames_required",
        "word_bank_required",
        "assessment_requested"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "language": {
          "const": "et"
        },
        "learner_level": {
          "enum": [
            "A1-A2",
            "not_applicable"
          ]
        },
        "allowed_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "terminology",
              "labels",
              "familiar_instruction",
              "sentence_frame",
              "short_oral_response",
              "short_written_response"
            ]
          }
        },
        "subject_explanation_language": {
          "const": "ru"
        },
        "sentence_frames_required": {
          "type": "boolean"
        },
        "word_bank_required": {
          "type": "boolean"
        },
        "assessment_requested": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "learner_level": {
            "const": "A1-A2"
          }
        }
      },
      "else": {
        "properties": {
          "learner_level": {
            "const": "not_applicable"
          },
          "allowed_roles": {
            "maxItems": 0,
            "type": "array"
          },
          "sentence_frames_required": {
            "const": false
          },
          "word_bank_required": {
            "const": false
          },
          "assessment_requested": {
            "const": false
          }
        }
      }
    }
  }
}
