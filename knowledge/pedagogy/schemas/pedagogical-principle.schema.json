{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-principle.schema.json",
  "title": "Pedagogical principle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "principle_id",
    "names",
    "category",
    "summary_ru",
    "provenance_claims",
    "intended_outcomes",
    "suitable_grades",
    "grade_adaptations",
    "delivery_modes",
    "risks",
    "not_equivalent_to",
    "limitations_ru",
    "grade5_science_applicability",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "pedagogical_principle"
    },
    "principle_id": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
    },
    "names": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/localizedNames"
    },
    "category": {
      "enum": [
        "learning_science",
        "motivation",
        "metacognition",
        "attention_and_environment",
        "planning_and_self_management",
        "social_learning",
        "assessment_for_learning"
      ]
    },
    "summary_ru": {
      "type": "string",
      "minLength": 1
    },
    "provenance_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/provenanceClaim"
      }
    },
    "intended_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "long_term_retention",
          "understanding_check",
          "misconception_detection",
          "knowledge_transfer",
          "motivation",
          "learner_autonomy",
          "sense_of_competence",
          "psychological_safety",
          "attention_control",
          "task_completion",
          "planning_accuracy",
          "metacognitive_awareness",
          "quality_feedback",
          "oral_explanation",
          "collaborative_understanding"
        ]
      }
    },
    "suitable_grades": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/gradeRange"
    },
    "grade_adaptations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grade_band",
          "guidance_ru",
          "claim_origin"
        ],
        "properties": {
          "grade_band": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/gradeBand"
          },
          "guidance_ru": {
            "type": "string",
            "minLength": 1
          },
          "claim_origin": {
            "const": "project_authored_design"
          }
        }
      }
    },
    "delivery_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/deliveryMode"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_id",
          "description_ru",
          "mitigation_ru"
        ],
        "properties": {
          "risk_id": {
            "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
          },
          "description_ru": {
            "type": "string",
            "minLength": 1
          },
          "mitigation_ru": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "not_equivalent_to": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/stableId"
      }
    },
    "limitations_ru": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "grade5_science_applicability": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/grade5ScienceApplicability"
    },
    "confidence": {
      "$ref": "https://opiq-helper.local/knowledge/pedagogy/schemas/pedagogical-common.schema.json#/$defs/confidence"
    }
  }
}
