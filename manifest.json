{
  "manifest_version": 3,
  "name": "Opiq Book Scraper",
  "version": "3.0",
  "description": "Собирает структурированную базу знаний из учебников Opiq",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
